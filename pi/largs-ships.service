[Unit]
Description=Relay Largs Channel vessel positions (aisstream.io) to largs.scot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# AISSTREAM_KEY lives here, mode 600, never in the repo
EnvironmentFile=/etc/largs-ships.env
ExecStart=/usr/bin/python3 /opt/largs/ships.py
Restart=always
RestartSec=30
User=root
# the two key files are the only secrets; keep the service's view of the world small
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
