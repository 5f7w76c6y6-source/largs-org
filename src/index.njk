---
layout: layouts/base.njk
heading: Largs today
subtitle: The day's essentials for the town — sea, sky, boats, trains and roads.
---
{% import "tile-icons.njk" as icons %}
{# ================= LARGS TODAY ================= #}
{% include "notice.njk" %}
{% include "power-notice.njk" %}

<section class="board wrap" aria-labelledby="page-title">
  <div class="kicker">
    {% if today.fetchedAt %}
    <span class="stamp">Updated {{ today.fetchedAt | hhmm }} · rebuilt every half hour</span>
    {% else %}
    <span class="stamp">Sample values — run npm run fetch</span>
    {% endif %}
  </div>
  <div class="tiles">

    <div class="tile">
      <div class="label">Weather
        {% if today.weather.ok %}<span class="badge live">live</span>{% else %}<span class="badge sample">sample</span>{% endif %}
      </div>
      {% if today.weather.ok %}
      <div class="weather-row">{% if today.weather.code is defined %}{{ icons.weatherGlyph(today.weather.code, today.weather.isDay) }}{% endif %}<div class="figure">{{ today.weather.tempC }}°C</div></div>
      <div class="sub">{{ today.weather.description }}{% if today.weather.feelsLine %} · {{ today.weather.feelsLine }}{% endif %}</div>
      <div class="sub">{{ today.weather.windName or today.weather.windDir }}, <span class="mono">{{ today.weather.windMph }} mph</span></div>
      {# The next eight hours, in two-hour blocks. The times are printed
         rather than described: "next 8 hours" would be a rolling window
         whose meaning slides through the day, and four glyphs under such
         a heading read as four snapshots rather than four spans. #}
      {% if today.weather.outlook and today.weather.outlook | length %}
      <ol class="outlook" aria-label="The next eight hours">
        {% for b in today.weather.outlook %}
        <li>{{ icons.weatherGlyph(b.code, b.isDay, "outlook-glyph") }}<span class="mono">{{ b.hour }}</span></li>
        {% endfor %}
      </ol>
      {% endif %}
      {% else %}
      <div class="figure">—</div>
      <div class="sub">Live feed not fetched yet</div>
      {% endif %}
    </div>

    {% set ev = today.tides.events or [] %}
    {% set tidesOk = today.tides.ok and (ev | length) >= 3 %}
    <div class="tile">
      <div class="label">Largs tides
        {% if tidesOk and today.tides.source == "ukho" %}<span class="badge live">live</span>{% elif tidesOk %}<span class="badge model">model</span>{% else %}<span class="badge sample">sample</span>{% endif %}
      </div>
      {% if tidesOk %}
      <div class="figure">{{ ev[0].type }} {{ ev[0].time | hhmm }}</div>
      <div class="sub">{{ ev[1].type }} <span class="mono">{{ ev[1].time | hhmm }}</span> · next {{ ev[2].type | lower }} <span class="mono">{{ ev[2].time | hhmm }}</span></div>
      {% if today.tides.curve %}
      <svg class="tide-curve" viewBox="0 0 {{ today.tides.curve.w }} {{ today.tides.curve.h }}"
           preserveAspectRatio="none" role="img"
           aria-label="Sea level over the next 24 hours — model estimate">
        <polygon points="{{ today.tides.curve.area }}" fill="var(--foam-tint)"/>
        <polyline points="{{ today.tides.curve.line }}" fill="none"
                  stroke="var(--slate)" stroke-width="1.5"
                  vector-effect="non-scaling-stroke"/>
        {% if today.tides.curve.nowX %}
        <path d="M {{ today.tides.curve.nowX }} {{ today.tides.curve.nowY }} l 0.01 0" stroke="var(--card)" stroke-width="13" stroke-linecap="round" vector-effect="non-scaling-stroke" fill="none"/>
        <path d="M {{ today.tides.curve.nowX }} {{ today.tides.curve.nowY }} l 0.01 0" stroke="var(--teal)" stroke-width="9" stroke-linecap="round" vector-effect="non-scaling-stroke" fill="none"/>
        {% endif %}
      </svg>
      {% endif %}
      {% else %}
      <div class="figure">—</div>
      <div class="sub">Live feed not fetched yet</div>
      {% endif %}
    </div>

    <div class="tile">
      <div class="label">Sea temp.
        {% if today.tides.seaTempC %}<span class="badge model">model</span>{% else %}<span class="badge sample">sample</span>{% endif %}
      </div>
      <img class="tile-hero" src="/assets/img/dookers-3.png"
           alt="Silhouette of a group of sea swimmers in woolly hats"
           width="720" height="420" loading="lazy" decoding="async">
      {% if today.tides.seaTempC %}
      <div class="figure">{{ today.tides.seaTempC }}°C</div>
      <div class="sub">Firth of Clyde · Fairlie channel</div>
      {% else %}
      <div class="figure">—</div>
      <div class="sub">Live feed not fetched yet</div>
      {% endif %}
    </div>

    <div class="tile">
      <div class="label">Daylight
        {% if today.weather.sunrise %}<span class="badge live">live</span>{% else %}<span class="badge sample">sample</span>{% endif %}
      </div>
      {% if today.weather.sunrise %}
      <div class="figure">{{ today.weather.sunrise }}</div>
      <div class="sub">Sunrise · sunset <span class="mono">{{ today.weather.sunset }}</span></div>
      {% if sunarc.ok %}
      {# The whole day as a clock face: noon at the top, midnight at the
         bottom, the sky-coloured share running sunrise to sunset — fat in
         June, a sliver at Christmas. The portion boundaries ARE sunrise
         and sunset. The sun rides the rim at the current time; after
         dark it crosses the night portion as a pale dot, because a
         yellow sun at midnight would be a lie. #}
      <svg class="daylight-arc" viewBox="0 0 100 100" role="img"
           aria-label="The day drawn as a circle, its daylight share coloured as sky{% if sunarc.day %}, with the sun at the current time{% endif %}">
        <path d="{{ sunarc.dayPath }}" fill="var(--sky-tint)"/>
        <path d="{{ sunarc.nightPath }}" fill="var(--slate-deep)" opacity=".82"/>
        <circle cx="50" cy="50" r="38" fill="none" stroke="var(--slate)"
                stroke-width="1.5" vector-effect="non-scaling-stroke"/>
        <path d="M {{ sunarc.sunX }} {{ sunarc.sunY }} l 0.01 0" stroke="var(--card)" stroke-width="14" stroke-linecap="round" vector-effect="non-scaling-stroke" fill="none"/>
        <path d="M {{ sunarc.sunX }} {{ sunarc.sunY }} l 0.01 0" stroke="{% if sunarc.day %}#D9A72E{% else %}#C9D2CF{% endif %}" stroke-width="10" stroke-linecap="round" vector-effect="non-scaling-stroke" fill="none"/>
      </svg>
      {% endif %}
      {% else %}
      <div class="figure">—</div>
      <div class="sub">Live feed not fetched yet</div>
      {% endif %}
    </div>

    <div class="tile">
      <div class="label">Cumbrae ferry</div>
      <img class="tile-hero" src="/assets/img/ferry-2.png"
           alt="Silhouette of a Clyde ferry under way" width="720" height="420"
           loading="lazy" decoding="async">
      {# Source: CalMac summer 2026 timetable for Largs–Cumbrae Slip, valid
         27 Mar – 18 Oct 2026 (PDF last updated 26 Mar 2026). Departures every
         20 minutes from 09:30 to 19:30 Mon–Sat and from 10:00 on Sundays;
         sparser early morning and after 20:10. Last winter's timetable ran
         every 30 minutes; winter 2026/27 not yet published as of 31 Aug 2026.
         Corrected 31 Aug 2026 from "every 15 min", which was never sourced
         (a resident-reported error, confirmed against the timetable).
         RE-CHECK BEFORE 19 OCT 2026 — the winter figure will differ. #}
      <div class="figure compact">Usually every 20 min</div>
      <div class="sub">Largs to Cumbrae Slip · <a href="{{ site.links.calmacTimetable }}">timetable →</a> · <a href="{{ site.links.calmacStatus }}">live status →</a></div>
    </div>

    {# Harbour webcam — CMAL's camera at the Largs ferry slip. CMAL own
       the harbour; CalMac only run the ferry. We LINK to CMAL's page and
       never embed the Twitch player: it needs Twitch cookies and scripts,
       and this page carries none. Not labelled "live" — the stream can
       sit minutes behind, and its burned-in clock is only as good as the
       encoder's. Courtesy email to webcams@cmassets.co.uk, Sep 2026
       (also asked about a periodic still frame and the pier tide gauge). #}
    <div class="tile">
      <div class="label">Harbour webcam</div>
      <img class="tile-hero" src="/assets/img/webcam.png"
           alt="Silhouette of a webcam on a stand" width="720" height="420"
           loading="lazy" decoding="async">
      <div class="sub">CMAL's camera at the ferry slip · <a href="{{ site.links.cmalWebcam }}" target="_blank" rel="noopener">watch the harbour →</a></div>
    </div>

    {# PS Waverley — the last seagoing paddle steamer, a Clyde icon.
       Permanent tile: the link answers "where is she right now?"
       wherever she is — Firth, Thames or south coast — so no location
       is claimed and no season gate is needed. Identity verified from
       her VesselFinder page, 12 Aug 2026: MMSI 232001540. #}
    <div class="tile">
      <div class="label">PS Waverley <span class="badge timetable">1946</span></div>
      <img class="tile-hero" src="/assets/img/waverley.png"
           alt="Silhouette of the paddle steamer Waverley"
           width="720" height="238" loading="lazy" decoding="async">
      <div class="sub">The last seagoing paddle steamer, still sailing · <a href="{{ waverley.trackerUrl }}" target="_blank" rel="noopener">where is she right now? →</a></div>
    </div>

    {# Overhead — live aircraft within 20 nm, the Waverley's sibling
       tile: her 1946 silhouette and a DC-3-era propliner, the aircraft
       that shared her sky. Page and data notes in src/overhead.njk. #}
    <div class="tile">
      <div class="label">Overhead <span class="badge live">live</span></div>
      <img class="tile-hero" src="/assets/img/overhead.png"
           alt="Silhouette of a vintage propeller airliner"
           width="720" height="238" loading="lazy" decoding="async">
      <div class="sub">Glasgow, Prestwick and the transatlantics · <a href="/overhead/">what's up there right now? →</a></div>
    </div>

    <div class="tile">
      <div class="label">Trains to Glasgow</div>
      <img class="tile-hero" src="/assets/img/train-2.png"
           alt="Silhouette of a steam express locomotive" width="720" height="420"
           loading="lazy" decoding="async">
      {# CORRECTED 30 Aug 2026, reported by a resident within a day of the site
         going up. It previously claimed two an hour, which is the
         GLASGOW-ARDROSSAN CORRIDOR figure — two trains an hour run down the
         coast and only one carries on to Largs. ScotRail's own timetable gives
         one train per hour between Glasgow and Largs at core daytime and at
         both peaks; their route page gives up to 18 a day between 06:35 and
         22:53, which is hourly and slightly over.

         A qualifier about evenings being thinner was drafted and dropped: the
         only support was a 2024 newspaper summary, and 18 trains across 16
         hours argues against it. The tile states the frequency it can stand
         behind; anyone needing an actual time follows the live departures
         link, which is authoritative in a way this line can never be.

         This tile and the Cumbrae ferry are the only two on the board carrying
         a hand-typed claim with no badge and no source. One of the two was
         wrong. Treat the other as unverified until checked against CalMac. #}
      <div class="figure compact">Usually hourly</div>
      <div class="sub">Largs to Glasgow Central · <a href="{{ site.links.rail }}">live departures →</a></div>
    </div>

    {# Buses — McGill's timetable now, Stagecoach's 585 to follow. No figure
       on purpose: "every 15 min" is true on a weekday until 16:30 and false
       on a Sunday or after tea, and "next" needs the clock, which lives on
       /buses/. So this tile is static, like everything on the board, and
       the page does the computing. Hero: bus.png, Alison's pipeline.
       Data notes in scripts/fetch-data.mjs (buses section). #}
    <div class="tile">
      <div class="label">Buses <span class="badge timetable">timetable</span></div>
      <img class="tile-hero" src="/assets/img/bus.png"
           alt="Silhouette of a single-deck bus" width="720" height="420"
           loading="lazy" decoding="async">
      <div class="sub">Glasgow, Greenock, Paisley and every stop in town · <a href="/buses/">next buses →</a></div>
    </div>

    {% set rw = today.roadworks %}
    <div class="tile">
      <div class="label">Roadworks
        {% if rw.ok %}<span class="badge daily">daily</span>{% else %}<span class="badge sample">sample</span>{% endif %}
      </div>
      <img class="tile-hero" src="/assets/img/roadworks.png"
           alt="Silhouette of a road worker leaning on a shovel" width="720" height="420"
           loading="lazy" decoding="async">
      {# No example works here any more. With twenty active, naming one is
         arbitrary -- it was only ever the first in the list -- and it read
         as THE roadworks rather than one of twenty. The sign says what the
         tile is, the figure says how many, the page has the detail. #}
      {% if rw.ok %}
      <div class="figure">{% if rw.count == 0 %}None{% else %}{{ rw.count }} active{% endif %}</div>
      {% else %}
      <div class="figure">1 active</div>
      {% endif %}
      <div class="sub"><a href="/roadworks/">see on map →</a></div>
    </div>

    {# Fuel. A door, not a gauge.

       Deliberately NO price here. One number cannot answer its own
       question -- "157.9p" prompts "is that good?" and does not say, so
       the reader has to tap anyway and the number bought nothing. Two
       numbers would answer it, but a range on the most-visited page,
       every day, is the homepage passing daily comment on the only
       forecourt in the town.

       No label icon, because the tile body DRAWS its subject -- the same
       rule that retired the weather cloud, the tide wave and the grey
       bin. fuel() stays in tile-icons.njk for any other surface.

       No status dot either: the dot answers "is this running normally",
       and fuel has no such state, same as sea temperature and bins. The
       badge is `sample` while the page runs on the frozen 23 August
       pull, and flips on its own when `fixture` goes false. #}
    {% if fuel and fuel.ok %}
    <div class="tile">
      <div class="label">Fuel
        {% if fuel.fixture %}<span class="badge sample">sample</span>{% else %}<span class="badge daily">daily</span>{% endif %}
      </div>
      <img class="tile-hero" src="/assets/img/fuel-2.png"
           alt="Silhouette of a forecourt fuel pump"
           width="560" height="420" loading="lazy" decoding="async">
      <div class="sub"><a href="/fuel/">local fuel prices →</a></div>
    </div>
    {% endif %}

    {# Bins hero v3 — the pair follows the week, and the conditional bin says so
       out loud. The coloured week is town-wide — bins.cjs verified the whole
       town runs one phase — so the main bin needs no qualifier at all; brown
       is the fortnightly half, so it names the calendar. Only the conditional
       bin is labelled: a bare bin beside a labelled one reads as the
       unconditional one, and at this tile's real width (about 194px on the
       board, 164px on a phone) two captions cannot both be legible and
       separated. Shrinking them to fit would undo the reason the coloured
       bins exist. The sub-line answers the question the label raises,
       because most people do not know their calendar letter.

       The labels are aria-hidden and the alt text carries the same statement
       as one sentence: two floating fragments read aloud, out of order and
       out of context, would be worse than useless. This hero states a fact
       rather than decorating one, so its alt says what it means.

       Festive weeks assert no colour: ink bin, no labels. #}
    <div class="tile">
      <div class="label">Bins this week</div>
      {% if bins.current.note %}
      <img class="tile-hero" src="/assets/img/bins-ink.png"
           alt="Silhouette of a dustbin" width="560" height="420"
           loading="lazy" decoding="async">
      <div class="figure">Dates move</div>
      <div class="sub">Festive collections this week · <a href="/bins/">bin days →</a></div>
      {% else %}
      <img class="tile-hero" src="/assets/img/bins-{{ bins.current.colour }}-brown.png"
           alt="Two dustbins at the kerb: {{ bins.current.name | lower }} for every street this week, brown for {{ bins.current.brownCalendar }} streets only"
           width="720" height="420" loading="lazy" decoding="async">
      <div class="bin-labels" aria-hidden="true">
        <span class="bin-label at-brown">{{ bins.current.brownCalendar }} only</span>
      </div>
      <div class="figure">{{ bins.current.name }}</div>
      <div class="sub">Not sure which calendar? · <a href="/bins/">bin days →</a></div>
      {% endif %}
    </div>

  </div>
  {# The honesty disclosure. Every tile carries a badge; this is the one
     place that says what each badge means and how fresh the board is.
     Native <details> — no JavaScript on the front page, by design. #}
  <details class="updates-note">
    <summary>About these updates</summary>
    <div class="updates-body">
      <p>This board rebuilds roughly every half hour, on its own, whether or
      not anyone is editing the site. Each tile says where its figure came
      from, and nothing on this page is a guess — where a feed is not wired up
      yet, the tile says so rather than showing a plausible number.</p>
      <ul class="badge-key">
        <li><span class="badge live">live</span> Fetched fresh at the last rebuild.</li>
        <li><span class="badge daily">daily</span> From an official register, refreshed overnight.</li>
        <li><span class="badge model">model</span> A computer model's estimate, not a reading from an instrument.</li>
        <li><span class="badge timetable">timetable</span> A fixed published pattern, with a link out to live status.</li>
        <li><span class="badge sample">sample</span> A placeholder, shown only until the real feed is connected.</li>
      </ul>
      <p class="updates-foot">Power cut notices use SP Energy Networks data
      (SC389555), © Scottish Power Ltd, from the
      <a href="https://spenergynetworks.opendatasoft.com/explore/assets/national-energy-outage-data/">SPEN Open Data Portal</a>
      under the
      <a href="https://spenergynetworks.opendatasoft.com/p/sp-energy-networks-open-data-licence/">SP Energy Networks Open Data Licence</a>
      — filtered here to the Largs area and provided as-is, without
      warranty. The notice hides itself whenever our last successful
      check is more than thirty minutes old, and incidents affecting
      fewer than five customers never appear in the feed at all, so the
      absence of a notice is not an all-clear. If you are affected, call
      <a href="tel:105">105</a>.</p>
      <p class="updates-foot">Tide times here are an ocean-model estimate and
      have measured 30 to 56 minutes early against the official predictions.
      For anything that depends on the water — a crossing, a swim, a boat —
      use <a href="https://easytide.admiralty.co.uk/">EasyTide</a>.</p>
    </div>
  </details>
</section>

{# ================= ON TODAY ================= #}
{% set todayEvents = events.items | todayOnly %}
{% set todayRegulars = events.regulars | regularsToday %}
{% if (todayEvents | length) + (todayRegulars | length) > 0 %}
<section class="board wrap" aria-labelledby="today-events-h">
  <div class="kicker">
    <span id="today-events-h">On today</span>
  </div>
  {% for e in todayEvents %}
  <article class="event">
    <div class="when">
      <div class="dow">{{ e.badgeTop }}</div>
      {# badgeDom, not e.date: a multi-day event running today must show
         today, not the day it started. Set in todayOnly. #}
      <div class="dom">{{ e.badgeDom or (e.date | dom) }}</div>
    </div>
    <div class="event-body">
      {# NO IMAGES HERE, deliberately. Everything on this board answers a
         question about today — an event poster does not, and it would be the
         only photograph among the site's own illustrations. It also referenced
         a class that no longer exists, so it would have rendered a full-size
         poster mid-board on 6 September. What's on carries the image. #}
      <h3>{{ e.title }}</h3>
      <div class="meta">{{ e.venue | upper }} · {{ e.time | upper }}</div>
      <p>{{ e.blurb }}</p>
    </div>
  </article>
  {% endfor %}

  {# Regular classes and clubs meeting today. Same .event markup as
     above so they read as one list — the time takes the place of the
     date block, since a weekly class has no date to show. #}
  {# Regulars that share an `org` collapse to one line — an organisation
     with a dozen classes on a Tuesday would otherwise fill the board.
     What's on lists every one of them. #}
  {% set dayShort = {"monday":"Mon","tuesday":"Tue","wednesday":"Wed","thursday":"Thu","friday":"Fri","saturday":"Sat","sunday":"Sun"} %}
  {% set orgsSeen = [] %}
  {% for r in todayRegulars %}
  {% if r.org and r.org.name %}
    {% if r.org.name not in orgsSeen %}
    {% set orgsSeen = (orgsSeen.push(r.org.name), orgsSeen) %}
    {% set mine = [] %}
    {% for x in todayRegulars %}{% if x.org and x.org.name == r.org.name %}{% set mine = (mine.push(x), mine) %}{% endif %}{% endfor %}
  <article class="event">
    <div class="when">
      <div class="dow">Every</div>
      <div class="dom">{{ dayShort[r.weekday] }}</div>
    </div>
    <div class="event-body">
      <h3>{{ r.org.name }} — {{ mine | length }} {% if (mine | length) == 1 %}activity{% else %}activities{% endif %} today</h3>
      <div class="meta">{% for x in mine %}{{ x.title | upper }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
      <p><a href="/whats-on/#regulars">Times and venues on What's on →</a></p>
    </div>
  </article>
    {% endif %}
  {% else %}
  <article class="event">
    <div class="when">
      <div class="dow">Every</div>
      <div class="dom">{{ dayShort[r.weekday] }}</div>
    </div>
    <div class="event-body">
      <h3>{{ r.title }}</h3>
      <div class="meta">{% if r.venue %}{{ r.venue | upper }}{% endif %}{% if r.venue and r.time %} · {% endif %}{% if r.time %}{{ r.time | upper }}{% endif %}</div>
      {% if r.blurb %}<p>{{ r.blurb }}</p>{% endif %}
    </div>
  </article>
  {% endif %}
  {% endfor %}

  {# Every other tile on this board ends with a way onward — "see on map",
     "bin days", "local fuel prices". On today had none: a reader could see
     what was happening and had nowhere to go for the detail, the booking
     link or the poster. One link for the section rather than one per event,
     because the board is deliberately terse and What's on is where the
     detail lives. #}
  <p class="sub board-more"><a href="/whats-on/">all events →</a></p>
</section>
{% endif %}

{# ================= QUICK LINKS ================= #}
<div class="today-links wrap">
  <a class="today-link-card" href="/whats-on/">
    <span class="today-link-label">What's on</span>
    <span class="today-link-sub">Upcoming events in Largs →</span>
  </a>
  <a class="today-link-card" href="/council/">
    <span class="today-link-label">Largs Community Council</span>
    <span class="today-link-sub">Latest digest: {{ council.latestMinutes | monthYear }} →</span>
  </a>
  <a class="today-link-card" href="/photos/">
    <span class="today-link-label">Photos</span>
    <span class="today-link-sub">Largs through the year →</span>
  </a>
  {# Not a board tile. Everything on the board answers a question about today
     and carries a freshness badge; a directory does neither, and putting it up
     there would weaken the board's own rule. This row is where sections that
     matter but are not about today already live. #}
  <a class="today-link-card" href="/directory/">
    <span class="today-link-label">Town directory</span>
    <span class="today-link-sub">Clubs, groups and places →</span>
  </a>
</div>

{# ================= NEWSLETTER ================= #}
<section class="newsletter" aria-labelledby="letter-h">
  <div class="newsletter-inner wrap">
    <div>
      <h2 id="letter-h">The Largs Letter</h2>
      {# No schedule promised until there is one to keep. The contents are
         named instead, because the council digest is the part nobody else
         does and it is the actual reason to subscribe. #}
      <p>The month's essentials in one email — what's on, bin days, and what
      the Community Council decided.</p>
    </div>
    {# The signup field and button that used to sit here did nothing —
       no form, no action, no handler — so anyone who typed an address
       was silently dropped. Replaced with a mailto that actually works,
       matching the events submission pattern. TO DO: replace with a real
       provider form (Buttondown free tier gives an endpoint, an archive
       and clean export) once one is chosen. #}
    <div class="signup">
      <a class="more" href="mailto:letter@largs.scot?subject=Largs%20Letter%20-%20please%20add%20me&body=Please%20add%20this%20address%20to%20the%20Largs%20Letter%20list.%0A%0A(You%20can%20ask%20to%20be%20removed%20at%20any%20time%20by%20replying%20to%20any%20issue.)">Join the list →</a>
    </div>
  </div>
</section>

