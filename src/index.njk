---
layout: layouts/base.njk
---
{# ================= LARGS TODAY ================= #}
<section class="board wrap" aria-labelledby="today-h">
  <div class="kicker">
    <span id="today-h">Largs today</span>
    {% if today.fetchedAt %}
    <span class="stamp">Updated {{ today.fetchedAt | hhmm }} · rebuilt every half hour</span>
    {% else %}
    <span class="stamp">Sample values — run npm run fetch</span>
    {% endif %}
  </div>
  <div class="tiles">

    <div class="tile">
      <div class="label">Weather
        {% if today.weather.ok %}<span class="badge live">live</span>{% else %}<span class="badge sample">sample</span>{% endif %}
      </div>
      {% if today.weather.ok %}
      <div class="figure">{{ today.weather.tempC }}°C</div>
      <div class="sub">{{ today.weather.description }} · <span class="mono">{{ today.weather.windDir }} {{ today.weather.windMph }} mph</span></div>
      {% else %}
      <div class="figure">—</div>
      <div class="sub">Live feed not fetched yet</div>
      {% endif %}
    </div>

    {% set ev = today.tides.events or [] %}
    {% set tidesOk = today.tides.ok and (ev | length) >= 3 %}
    <div class="tile">
      <div class="label">Tides · Largs
        {% if tidesOk and today.tides.source == "ukho" %}<span class="badge live">live</span>{% elif tidesOk %}<span class="badge model">model</span>{% else %}<span class="badge sample">sample</span>{% endif %}
      </div>
      {% if tidesOk %}
      <div class="figure">{{ ev[0].type }} {{ ev[0].time | hhmm }}</div>
      <div class="sub">{{ ev[1].type }} <span class="mono">{{ ev[1].time | hhmm }}</span> · next {{ ev[2].type | lower }} <span class="mono">{{ ev[2].time | hhmm }}</span></div>
      {% if today.tides.curve %}
      <svg class="tide-curve" viewBox="0 0 {{ today.tides.curve.w }} {{ today.tides.curve.h }}"
           preserveAspectRatio="none" role="img"
           aria-label="Sea level over the next 24 hours — model estimate">
        <polygon points="{{ today.tides.curve.area }}" fill="var(--foam-tint)"/>
        <polyline points="{{ today.tides.curve.line }}" fill="none"
                  stroke="var(--slate)" stroke-width="1.5"
                  vector-effect="non-scaling-stroke"/>
        {% if today.tides.curve.nowX %}
        <circle cx="{{ today.tides.curve.nowX }}" cy="{{ today.tides.curve.nowY }}" r="3" fill="var(--teal)"/>
        {% endif %}
      </svg>
      {% endif %}
      {% else %}
      <div class="figure">—</div>
      <div class="sub">Live feed not fetched yet</div>
      {% endif %}
    </div>

    <div class="tile">
      <div class="label"><span class="dot ok" aria-hidden="true"></span>Cumbrae ferry <span class="badge timetable">timetable</span></div>
      <div class="figure">Every 15 min</div>
      <div class="sub">Summer service from the Slip · <a href="{{ site.links.calmacStatus }}">live status: CalMac →</a></div>
    </div>

    <div class="tile">
      <div class="label"><span class="dot ok" aria-hidden="true"></span>Trains <span class="badge timetable">timetable</span></div>
      <div class="figure">xx:14 / xx:44</div>
      <div class="sub">To Glasgow Central · <a href="{{ site.links.rail }}">live departures →</a></div>
    </div>

    {% set rw = today.roadworks %}
    <div class="tile">
      <div class="label"><span class="dot {% if rw.ok and rw.count == 0 %}ok{% else %}warn{% endif %}" aria-hidden="true"></span>Roadworks
        {% if rw.ok %}<span class="badge daily">daily</span>{% else %}<span class="badge sample">sample</span>{% endif %}
      </div>
      {% if rw.ok %}
      <div class="figure">{% if rw.count == 0 %}None{% else %}{{ rw.count }} active{% endif %}</div>
      {% if rw.count > 0 %}
      {% set w = rw.items[0] %}
      <div class="sub">{{ w.what }}{% if w.what and w.where %}, {% endif %}{{ w.where }}{% if w.until %} until <span class="mono">{{ w.until | dom }} {{ w.until | monthShort }}</span>{% endif %} · <a href="/getting-about/">map →</a></div>
      {% else %}
      <div class="sub">Nothing registered on Largs streets · <a href="/getting-about/">map →</a></div>
      {% endif %}
      {% else %}
      <div class="figure">1 active</div>
      <div class="sub">Temporary lights, Brisbane Rd until <span class="mono">14 Aug</span></div>
      {% endif %}
    </div>

  </div>
  <p class="board-legend">live = fetched at the last rebuild · daily = official register, refreshed overnight · model = ocean-model estimate, measured up to an hour out here — official times: <a href="https://easytide.admiralty.co.uk">EasyTide</a> · timetable = fixed pattern with a link out · sample = placeholder until the feed is wired up</p>
</section>

{# ================= WEEK + COUNCIL ================= #}
<div class="cols wrap">
  <section aria-labelledby="week-h">
    <h2 id="week-h">This week in Largs</h2>
    <div class="rule" aria-hidden="true"></div>

    {% if events.sample %}
    <p class="sample-note">These entries show the layout only — none is a
    confirmed event yet. Real listings will replace them.</p>
    {% endif %}

    {% for e in events.items | upcoming %}
    <article class="event">
      <div class="when">
        <div class="dow">{% if e.farOut %}{{ e.date | monthShort }}{% else %}{{ e.date | dow }}{% endif %}</div>
        <div class="dom">{{ e.date | dom }}</div>
      </div>
      <div class="event-body">
        {% if e.image %}
        <img class="event-img" src="{{ e.image }}" alt="{{ e.title }}" loading="lazy" decoding="async">
        {% endif %}
        <h3>{{ e.title }}</h3>
        <div class="meta">{{ e.venue | upper }} · {{ e.time | upper }}</div>
        <p>{{ e.blurb }}</p>
      </div>
    </article>
    {% endfor %}

    <a class="more" href="mailto:largsevents@gmail.com?subject=Event%20submission%20for%20largs.org&body=Title%3A%0ADate%3A%0AVenue%3A%0ATime%3A%0ADescription%3A%0AWebsite%20or%20booking%20link%20(if%20any)%3A">Add your event — it's free →</a>
  </section>

  <aside class="council" aria-labelledby="council-h">
    <h2 id="council-h">Council corner</h2>
    <div class="rule" aria-hidden="true"></div>

    <h4>Community Council · {{ council.digestMonth }} digest</h4>

    {% if council.sample %}
    <p class="aside-sample">Sample layout — the first real digest follows the
    next published minutes.</p>
    {% endif %}

    {% set statusLabels = { "progress": "In progress", "watching": "Watching", "done": "Done" } %}
    {% for item in council.digest %}
    <div class="digest-item">
      <div class="decided">{{ item.decided }}</div>
      <div class="who">{{ item.who }}</div>
      <span class="chip {{ item.status }}">{{ statusLabels[item.status] }}</span>
    </div>
    {% endfor %}

    <h4>Next meeting</h4>
    <ul>
      <li>{% if council.meeting.confirmed %}{{ council.meeting.when }} <span class="mono">· {{ council.meeting.note }}</span>{% else %}Next date to be confirmed{% endif %}</li>
      <li><a href="/council/">Council corner: the full page →</a></li>
    </ul>
  </aside>
</div>

{# ================= NEWSLETTER ================= #}
<section class="newsletter" aria-labelledby="letter-h">
  <div class="newsletter-inner wrap">
    <div>
      <h2 id="letter-h">The Largs Letter</h2>
      <p>The month's essentials in one email — first Friday, no clutter.</p>
    </div>
    <div class="signup">
      <input type="email" placeholder="you@example.com" aria-label="Email address">
      <button type="button">Sign up</button>
    </div>
  </div>
</section>

{# ================= DIRECTORY ================= #}
<section class="directory wrap" aria-labelledby="dir-h">
  <h2 id="dir-h">Town directory</h2>
  <div class="rule" aria-hidden="true"></div>
  <div class="chips">
    <a href="#">Clubs &amp; societies</a>
    <a href="#">Cafés &amp; food</a>
    <a href="#">Trades</a>
    <a href="#">Accommodation</a>
    <a href="#">Halls for hire</a>
    <a href="#">Churches</a>
    <a href="#">Sport &amp; leisure</a>
    <a href="#">Sailing &amp; marina</a>
  </div>
  <p class="note">180+ local listings, carried over in full from the original largs.org. Listings remain free.</p>
</section>
