---
layout: layouts/base.njk
heading: Largs today
subtitle: The day's essentials for the town — sea, sky, boats, trains and roads.
---
{% import "tile-icons.njk" as icons %}
{# ================= LARGS TODAY ================= #}
<section class="board wrap" aria-labelledby="page-title">
  <div class="kicker">
    {% if today.fetchedAt %}
    <span class="stamp">Updated {{ today.fetchedAt | hhmm }} · rebuilt every half hour</span>
    {% else %}
    <span class="stamp">Sample values — run npm run fetch</span>
    {% endif %}
  </div>
  <div class="tiles">

    <div class="tile">
      <div class="label">{{ icons.weather() }}Weather
        {% if today.weather.ok %}<span class="badge live">live</span>{% else %}<span class="badge sample">sample</span>{% endif %}
      </div>
      {% if today.weather.ok %}
      <div class="figure">{{ today.weather.tempC }}°C</div>
      <div class="sub">{{ today.weather.description }} · <span class="mono">{{ today.weather.windDir }} {{ today.weather.windMph }} mph</span></div>
      {% else %}
      <div class="figure">—</div>
      <div class="sub">Live feed not fetched yet</div>
      {% endif %}
    </div>

    {% set ev = today.tides.events or [] %}
    {% set tidesOk = today.tides.ok and (ev | length) >= 3 %}
    <div class="tile">
      <div class="label">{{ icons.tides() }}Tides · Largs
        {% if tidesOk and today.tides.source == "ukho" %}<span class="badge live">live</span>{% elif tidesOk %}<span class="badge model">model</span>{% else %}<span class="badge sample">sample</span>{% endif %}
      </div>
      {% if tidesOk %}
      <div class="figure">{{ ev[0].type }} {{ ev[0].time | hhmm }}</div>
      <div class="sub">{{ ev[1].type }} <span class="mono">{{ ev[1].time | hhmm }}</span> · next {{ ev[2].type | lower }} <span class="mono">{{ ev[2].time | hhmm }}</span></div>
      {% if today.tides.curve %}
      <svg class="tide-curve" viewBox="0 0 {{ today.tides.curve.w }} {{ today.tides.curve.h }}"
           preserveAspectRatio="none" role="img"
           aria-label="Sea level over the next 24 hours — model estimate">
        <polygon points="{{ today.tides.curve.area }}" fill="var(--foam-tint)"/>
        <polyline points="{{ today.tides.curve.line }}" fill="none"
                  stroke="var(--slate)" stroke-width="1.5"
                  vector-effect="non-scaling-stroke"/>
        {% if today.tides.curve.nowX %}
        <circle cx="{{ today.tides.curve.nowX }}" cy="{{ today.tides.curve.nowY }}" r="4" fill="var(--teal)" stroke="var(--card)" stroke-width="1.5" vector-effect="non-scaling-stroke"/>
        {% endif %}
      </svg>
      {% endif %}
      {% else %}
      <div class="figure">—</div>
      <div class="sub">Live feed not fetched yet</div>
      {% endif %}
    </div>

    <div class="tile">
      <div class="label">{{ icons.seatemp() }}Sea temperature
        {% if today.tides.seaTempC %}<span class="badge model">model</span>{% else %}<span class="badge sample">sample</span>{% endif %}
      </div>
      {% if today.tides.seaTempC %}
      <div class="figure">{{ today.tides.seaTempC }}°C</div>
      <div class="sub">Firth of Clyde · Fairlie channel</div>
      {% else %}
      <div class="figure">—</div>
      <div class="sub">Live feed not fetched yet</div>
      {% endif %}
    </div>

    <div class="tile">
      <div class="label">{{ icons.daylight() }}Daylight
        {% if today.weather.sunrise %}<span class="badge live">live</span>{% else %}<span class="badge sample">sample</span>{% endif %}
      </div>
      {% if today.weather.sunrise %}
      <div class="figure">{{ today.weather.sunrise }}</div>
      <div class="sub">Sunrise · sunset <span class="mono">{{ today.weather.sunset }}</span></div>
      {% if sunarc.ok %}
      <svg class="daylight-arc" viewBox="0 0 100 48" role="img"
           aria-label="Today's daylight drawn as an arc{% if sunarc.day %}, with the sun's current position marked{% endif %}">
        <path d="M12 40 A38 38 0 0 1 88 40 Z" fill="var(--foam-tint)"/>
        <path d="M12 40 A38 38 0 0 1 88 40" fill="none" stroke="var(--slate)"
              stroke-width="1.5" vector-effect="non-scaling-stroke"/>
        {% if sunarc.day %}
        <circle cx="{{ sunarc.sunX }}" cy="{{ sunarc.sunY }}" r="4" fill="var(--teal)" stroke="var(--card)" stroke-width="1.5" vector-effect="non-scaling-stroke"/>
        {% endif %}
      </svg>
      {% endif %}
      {% else %}
      <div class="figure">—</div>
      <div class="sub">Live feed not fetched yet</div>
      {% endif %}
    </div>

    <div class="tile">
      <div class="label"><span class="dot ok" aria-hidden="true"></span>{{ icons.ferry() }}Cumbrae ferry <span class="badge timetable">timetable</span></div>
      <div class="figure">Normally every 15 min</div>
      <div class="sub">Summer timetable from the Slip · <a href="{{ site.links.calmacStatus }}">check live status →</a></div>
    </div>

    <div class="tile">
      <div class="label"><span class="dot ok" aria-hidden="true"></span>{{ icons.trains() }}Trains to Glasgow <span class="badge timetable">timetable</span></div>
      <div class="figure">Usually twice hourly</div>
      <div class="sub">Largs to Glasgow Central · <a href="{{ site.links.rail }}">live departures →</a></div>
    </div>

    {% set rw = today.roadworks %}
    <div class="tile">
      <div class="label"><span class="dot {% if rw.ok and rw.count == 0 %}ok{% else %}warn{% endif %}" aria-hidden="true"></span>{{ icons.roadworks() }}Roadworks
        {% if rw.ok %}<span class="badge daily">daily</span>{% else %}<span class="badge sample">sample</span>{% endif %}
      </div>
      {% if rw.ok %}
      <div class="figure">{% if rw.count == 0 %}None{% else %}{{ rw.count }} active{% endif %}</div>
      {% if rw.count > 0 %}
      {% set w = rw.items[0] %}
      <div class="sub">{{ w.what }}{% if w.what and w.where %}, {% endif %}{{ w.where }}{% if w.until %} until <span class="mono">{{ w.until | dom }} {{ w.until | monthShort }}</span>{% endif %} · <a href="/getting-about/">map →</a></div>
      {% else %}
      <div class="sub">Nothing registered on Largs streets · <a href="/getting-about/">map →</a></div>
      {% endif %}
      {% else %}
      <div class="figure">1 active</div>
      <div class="sub">Temporary lights, Brisbane Rd until <span class="mono">14 Aug</span></div>
      {% endif %}
    </div>

    <div class="tile">
      <div class="label">{{ icons.bins() }}Bins this week <span class="badge timetable">timetable</span></div>
      {% if bins.current.note %}
      <div class="figure">Dates move</div>
      <div class="sub">Festive collections this week · <a href="/bins/">bin days →</a></div>
      {% else %}
      <div class="figure">{{ bins.current.name }}</div>
      <div class="sub">Brown too for {{ bins.current.brownCalendar }} streets · <a href="/bins/">bin days →</a></div>
      {% endif %}
    </div>

  </div>
  {# The honesty disclosure. Every tile carries a badge; this is the one
     place that says what each badge means and how fresh the board is.
     Native <details> — no JavaScript on the front page, by design. #}
  <details class="updates-note">
    <summary>About these updates</summary>
    <div class="updates-body">
      <p>This board rebuilds roughly every half hour, on its own, whether or
      not anyone is editing the site. Each tile says where its figure came
      from, and nothing on this page is a guess — where a feed is not wired up
      yet, the tile says so rather than showing a plausible number.</p>
      <ul class="badge-key">
        <li><span class="badge live">live</span> Fetched fresh at the last rebuild.</li>
        <li><span class="badge daily">daily</span> From an official register, refreshed overnight.</li>
        <li><span class="badge model">model</span> A computer model's estimate, not a reading from an instrument.</li>
        <li><span class="badge timetable">timetable</span> A fixed published pattern, with a link out to live status.</li>
        <li><span class="badge sample">sample</span> A placeholder, shown only until the real feed is connected.</li>
      </ul>
      <p class="updates-foot">Tide times here are an ocean-model estimate and
      have measured 30 to 56 minutes early against the official predictions.
      For anything that depends on the water — a crossing, a swim, a boat —
      use <a href="https://easytide.admiralty.co.uk/">EasyTide</a>.</p>
    </div>
  </details>
</section>

{# ================= ON TODAY ================= #}
{% set todayEvents = events.items | todayOnly %}
{% if todayEvents | length > 0 %}
<section class="board wrap" aria-labelledby="today-events-h">
  <div class="kicker">
    <span id="today-events-h">On today</span>
  </div>
  {% for e in todayEvents %}
  <article class="event">
    <div class="when">
      <div class="dow">{% if e.farOut %}{{ e.date | monthShort }}{% else %}{{ e.date | dow }}{% endif %}</div>
      <div class="dom">{{ e.date | dom }}</div>
    </div>
    <div class="event-body">
      {% if e.image %}
      <img class="event-img" src="{{ e.image }}" alt="{{ e.title }}" loading="lazy" decoding="async">
      {% endif %}
      <h3>{{ e.title }}</h3>
      <div class="meta">{{ e.venue | upper }} · {{ e.time | upper }}</div>
      <p>{{ e.blurb }}</p>
    </div>
  </article>
  {% endfor %}
</section>
{% endif %}

{# ================= QUICK LINKS ================= #}
<div class="today-links wrap">
  <a class="today-link-card" href="/whats-on/">
    <span class="today-link-label">What's on</span>
    <span class="today-link-sub">Upcoming events in Largs →</span>
  </a>
  <a class="today-link-card" href="/council/">
    <span class="today-link-label">Council corner</span>
    <span class="today-link-sub">Latest digest: {{ council.digestMonth }} →</span>
  </a>
  <a class="today-link-card" href="/photos/">
    <span class="today-link-label">Photos</span>
    <span class="today-link-sub">Largs through the year →</span>
  </a>
</div>

{# ================= NEWSLETTER ================= #}
<section class="newsletter" aria-labelledby="letter-h">
  <div class="newsletter-inner wrap">
    <div>
      <h2 id="letter-h">The Largs Letter</h2>
      <p>The month's essentials in one email — first Friday, no clutter.</p>
    </div>
    <div class="signup">
      <input type="email" placeholder="you@example.com" aria-label="Email address">
      <button type="button">Sign up</button>
    </div>
  </div>
</section>

{# ================= DIRECTORY ================= #}
<section class="directory wrap" aria-labelledby="dir-h">
  <h2 id="dir-h">Town directory</h2>
  <div class="rule" aria-hidden="true"></div>
  <div class="chips">
    <a href="#">Clubs &amp; societies</a>
    <a href="#">Cafés &amp; food</a>
    <a href="#">Trades</a>
    <a href="#">Accommodation</a>
    <a href="#">Halls for hire</a>
    <a href="#">Churches</a>
    <a href="#">Sport &amp; leisure</a>
    <a href="#">Sailing &amp; marina</a>
  </div>
  <p class="note">180+ local listings, carried over in full from the original largs.org. Listings remain free.</p>
</section>
