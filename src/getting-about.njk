---
layout: layouts/base.njk
permalink: /getting-about/
title: Roadworks and street closures
heading: Roadworks and street closures
subtitle: Where the works are in and around Largs, from the Scottish Road Works Register.
---
{% set rw = today.roadworks %}
{# Inline glosses for the work-type labels that are genuinely jargon — each
   row must stand alone for a reader who never opens the disclosure. Plain
   labels (temporary lights, road closure…) deliberately get none. #}
{% set whatGloss = {
  "Give and take": "One lane, no lights — drivers give way to each other in turn.",
  "Priority working": "One lane — signs give one direction the right of way.",
  "Stop/go boards": "A worker at each end lets each direction through in turn.",
  "Convoy working": "Traffic is led through in a group behind a works vehicle.",
  "Contraflow": "Both directions run on one side of the road.",
  "Road restriction": "The register's catch-all — the exact arrangement isn't recorded."
} %}
<section class="board wrap" aria-labelledby="page-title">
  <div class="kicker">
    {% if rw.ok %}
    <span class="stamp">Register data to {{ rw.dataDate | dom }} {{ rw.dataDate | monthShort }} · refreshed overnight</span>
    {% endif %}
  </div>

  <p class="page-intro">Every registered occupation of a Largs street, from the
  Scottish Road Works Register — the statutory record all utilities and the
  council must file into. <strong>Red</strong> is under way now;
  <strong>amber</strong> is planned, so you can route round it before it
  arrives. The map shows where; the list below has the detail.</p>

  {% if rw.ok %}
  <p class="works-legend">
    <span><span class="swatch active"></span>{{ rw.activeCount }} under way</span>
    <span><span class="swatch planned"></span>{{ rw.plannedCount }} planned</span>
    <span>tap a dot for details</span>
  </p>

  <div id="works-map" role="application" aria-label="Map of road works in Largs. The same information is listed below."></div>

  {# The register's work-type labels are load-bearing jargon — each names a
     specific traffic arrangement, and plain substitutes lose the distinction.
     So the labels stay terse and this one place explains them, same pattern
     as the badge vocabulary on the Today board. Native <details>, no JS. #}
  <details class="updates-note">
    <summary>What the work types mean</summary>
    <div class="updates-body">
      <ul class="badge-key">
        <li><strong>Give and take</strong> — the road is narrowed to one lane with no lights or signs; drivers give way to each other in turn.</li>
        <li><strong>Priority working</strong> — one lane, with signs giving one direction the right of way.</li>
        <li><strong>Stop/go boards</strong> — a worker at each end turns a board to let each direction through in turn.</li>
        <li><strong>Temporary lights</strong> — portable traffic lights control each direction in turn.</li>
        <li><strong>Convoy working</strong> — traffic is led through the works in a group behind a works vehicle.</li>
        <li><strong>Contraflow</strong> — traffic runs in both directions on one side of the road.</li>
        <li><strong>Road narrowing</strong> — the road is narrower through the works but open both ways.</li>
        <li><strong>Lane closure</strong> — one lane is shut; the rest of the road runs as normal.</li>
        <li><strong>Road closure</strong> — the road is shut through the works; follow the signed diversion.</li>
        <li><strong>Slip road closed</strong> / <strong>hard shoulder closed</strong> — the main road runs; only the slip or shoulder is shut.</li>
        <li><strong>Pavement works</strong> — the work is on the pavement; the road itself runs as normal.</li>
        <li><strong>Road restriction</strong> — the register's catch-all, used when the exact arrangement isn't recorded.</li>
      </ul>
      <p class="updates-foot">Where no arrangement is registered at all, the work
      shows under its general type — minor, major, urgent, emergency or repair
      works — as the register records it.</p>
    </div>
  </details>

  {% for w in rw.items %}
  <article class="work-row">
    <span class="chip {{ w.status }}">{% if w.status == "active" %}Under way{% else %}Planned{% endif %}</span>
    <div class="work-main">
      <h3>{{ w.what }}{% if w.what and w.where %} — {% endif %}{{ w.where }}</h3>
      <p class="meta">
        {%- if w.promoter %}{{ w.promoter }}{% endif -%}
        {%- if w.status == "active" and w.until %} · due to finish {{ w.until | dom }} {{ w.until | monthShort }}{% endif -%}
        {%- if w.status == "planned" and w.from %} · starts {{ w.from | dom }} {{ w.from | monthShort }}{% endif -%}
        {%- if w.status == "planned" and w.until %} · until {{ w.until | dom }} {{ w.until | monthShort }}{% endif -%}
      </p>
      {% if whatGloss[w.what] %}<p class="work-gloss">{{ whatGloss[w.what] }}</p>{% endif %}
    </div>
  </article>
  {% endfor %}

  <p class="note">Source: Scottish Road Works Register open data (OGL v3),
  updated each night. Positions are as registered by the works promoter and
  can be approximate. Full national map:
  <a href="https://roadworksscotland.org">Scottish Road Works Online</a>.</p>

  {% else %}
  <p class="note">Road works data hasn't been fetched yet — the register feed
  will appear here after the next build.</p>
  {% endif %}
</section>

{% if rw.ok %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
/* This page is the one place the site runs JavaScript in the browser —
   the homepage stays pure HTML. Works data is baked in at build time. */
(function () {
  "use strict";
  var WORKS = {{ rw.items | dump | safe }};
  if (!window.L) return; // CDN unreachable: the list above stands alone.

  var map = L.map("works-map", { scrollWheelZoom: false });
  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
  }).addTo(map);

  function shortDate(iso) {
    var d = new Date(iso + "T12:00:00Z");
    return isNaN(d) ? "" : d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
  }

  var bounds = [];
  WORKS.forEach(function (w) {
    if (w.lat == null || w.lng == null) return;
    var active = w.status === "active";
    var marker = L.circleMarker([w.lat, w.lng], {
      radius: 9,
      color: "#FBF8F1",
      weight: 2,
      fillColor: active ? "#C03B2B" : "#B07A1F",
      fillOpacity: 0.9
    }).addTo(map);
    var lines = ["<strong>" + (w.what || "Road works") + "</strong>"];
    if (w.where) lines.push(w.where);
    if (w.promoter) lines.push(w.promoter);
    if (active) lines.push(w.until ? "Due to finish " + shortDate(w.until) : "No end date registered");
    else lines.push(w.from ? "Starts " + shortDate(w.from) : "Start date to be confirmed");
    marker.bindPopup(lines.join("<br>"));
    bounds.push([w.lat, w.lng]);
  });

  if (bounds.length) map.fitBounds(bounds, { padding: [28, 28], maxZoom: 16 });
  else map.setView([55.795, -4.868], 14); // Largs, when nothing is mappable
})();
</script>
{% endif %}
