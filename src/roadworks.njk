---
layout: layouts/base.njk
pagination:
  data: views
  size: 1
  alias: view
views:
  - key: all
    label: All works
    path: /roadworks/
  - key: active
    label: Under way
    path: /roadworks/under-way/
  - key: soon
    label: Starting soon
    path: /roadworks/starting-soon/
permalink: "{{ view.path }}"
eleventyComputed:
  title: "{{ view.label }} · Roadworks and street closures"
  heading: Roadworks and street closures
  subtitle: Where the works are in and around Largs, from the Scottish Road Works Register.
---
{# Build-time filter pages, the same mechanism as Council corner: this one
   template is rendered once per entry in `views`, and each rendering is
   written to its own folder. The chips are therefore plain links —
   bookmarkable, indexable, back-button correct, and working with
   JavaScript switched off. Nothing filters in the browser.

   `shown` is used for BOTH the list and the map's WORKS array, so the
   dots always match the rows, and the data-work indices stay in step. #}
{% set rw = today.roadworks %}
{% set shown = rw.items | filterWorks(view.key, rw.dataDate) %}
{% set countAll = rw.items | length %}
{% set countActive = rw.items | filterWorks("active", rw.dataDate) | length %}
{% set countSoon = rw.items | filterWorks("soon", rw.dataDate) | length %}
{% set countNoStart = rw.items | filterWorks("nostart", rw.dataDate) | length %}
{# Inline glosses for the work-type labels that are genuinely jargon — each
   row must stand alone for a reader who never opens the disclosure. Plain
   labels (temporary lights, road closure…) deliberately get none. #}
{% set whatGloss = {
  "Give and take": "One lane, no lights — drivers give way to each other in turn.",
  "Priority working": "One lane — signs give one direction the right of way.",
  "Stop/go boards": "A worker at each end lets each direction through in turn.",
  "Convoy working": "Traffic is led through in a group behind a works vehicle.",
  "Contraflow": "Both directions run on one side of the road.",
  "Road restriction": "The register's catch-all — the exact arrangement isn't recorded.",
  "Street occupation": "Part of the street is in use for something other than road works."
} %}
<section class="board wrap" aria-labelledby="page-title">
  <div class="kicker">
    {% if rw.ok %}
    <span class="stamp">Register data to {{ rw.dataDate | dom }} {{ rw.dataDate | monthShort }} · refreshed overnight</span>
    {% endif %}
  </div>

  <p class="page-intro">Every registered occupation of a Largs street, from the
  Scottish Road Works Register — the statutory record all utilities and the
  council must file into. <strong>Red</strong> is under way now;
  <strong>amber</strong> is planned, so you can route round it before it
  arrives. The map shows where; the list below has the detail.</p>

  {% if rw.ok %}
  {# The legend counts the whole register, so it belongs only on the
     unfiltered page — on a filter it would contradict the chips and the
     map below it. The chips carry the counts everywhere else. #}
  {% if view.key == "all" %}
  <p class="works-legend">
    <span><span class="swatch active"></span>{{ rw.activeCount }} under way</span>
    <span><span class="swatch planned"></span>{{ rw.plannedCount }} planned</span>
    {% if rw.permitCount %}<span>{{ rw.permitCount }} of them permits — skips, scaffolding and the like</span>{% endif %}
    <span>tap a dot for details</span>
  </p>
  {% else %}
  <p class="works-legend"><span>tap a dot for details</span></p>
  {% endif %}

  <nav class="works-filter" aria-label="Filter the works">
    <a href="/roadworks/"{% if view.key == "all" %} aria-current="page"{% endif %}>All works <span class="n">{{ countAll }}</span></a>
    <a href="/roadworks/under-way/"{% if view.key == "active" %} aria-current="page"{% endif %}>Under way <span class="n">{{ countActive }}</span></a>
    <a href="/roadworks/starting-soon/"{% if view.key == "soon" %} aria-current="page"{% endif %}>Starting soon <span class="n">{{ countSoon }}</span></a>
  </nav>

  {% if view.key == "soon" %}
  <p class="note">Works registered as starting within a fortnight of {{ rw.dataDate | dom }} {{ rw.dataDate | monthShort }}.{% if countNoStart %} {{ countNoStart }} planned {% if countNoStart == 1 %}work has{% else %}works have{% endif %} no start date registered and {% if countNoStart == 1 %}is{% else %}are{% endif %} only shown under all works.{% endif %}</p>
  {% endif %}

  <div id="works-map" role="application" aria-label="Map of road works in Largs. The same information is listed below."></div>

  {# The register's work-type labels are load-bearing jargon — each names a
     specific traffic arrangement, and plain substitutes lose the distinction.
     So the labels stay terse and this one place explains them, same pattern
     as the badge vocabulary on the Today board. Native <details>, no JS. #}
  <details class="updates-note">
    <summary>What the work types mean</summary>
    <div class="updates-body">
      <ul class="badge-key">
        <li><strong>Give and take</strong> — the road is narrowed to one lane with no lights or signs; drivers give way to each other in turn.</li>
        <li><strong>Priority working</strong> — one lane, with signs giving one direction the right of way.</li>
        <li><strong>Stop/go boards</strong> — a worker at each end turns a board to let each direction through in turn.</li>
        <li><strong>Temporary lights</strong> — portable traffic lights control each direction in turn.</li>
        <li><strong>Convoy working</strong> — traffic is led through the works in a group behind a works vehicle.</li>
        <li><strong>Contraflow</strong> — traffic runs in both directions on one side of the road.</li>
        <li><strong>Road narrowing</strong> — the road is narrower through the works but open both ways.</li>
        <li><strong>Lane closure</strong> — one lane is shut; the rest of the road runs as normal.</li>
        <li><strong>Road closure</strong> — the road is shut through the works; follow the signed diversion.</li>
        <li><strong>Slip road closed</strong> / <strong>hard shoulder closed</strong> — the main road runs; only the slip or shoulder is shut.</li>
        <li><strong>Pavement works</strong> — the work is on the pavement; the road itself runs as normal.</li>
        <li><strong>Road restriction</strong> — the register's catch-all, used when the exact arrangement isn't recorded.</li>
        <li><strong>Skip</strong>, <strong>scaffolding</strong>, <strong>street café</strong>, <strong>hoarding</strong> and the like — a permit to occupy part of the street, not road works. Any traffic arrangement it causes is shown on the same line.</li>
      </ul>
      <p class="updates-foot"><strong>High, medium and low impact</strong> are the
      register's own rating of how much a work disrupts traffic. <strong>May affect
      buses</strong> means a service passes within ten metres of the works — a
      measure of proximity, not a report of delay.</p>
      <p class="updates-foot">Where no arrangement is registered at all, the work
      shows under its general type — minor, major, urgent, emergency or repair
      works — as the register records it.</p>
    </div>
  </details>

  {% if shown | length == 0 %}
  <p class="note">Nothing registered under this filter. <a href="/roadworks/">See all works →</a></p>
  {% endif %}

  {% for w in shown %}
  <article class="work-row">
    <span class="chip {{ w.status }}">{% if w.status == "active" %}Under way{% else %}Planned{% endif %}</span>
    <div class="work-main">
      <h3>{{ w.what }}{% if w.what and w.where %} — {% endif %}{{ w.where }}</h3>
      <p class="meta">
        {%- if w.promoter %}{{ w.promoter }}{% endif -%}
        {%- if w.status == "active" and w.until %} · {% if w.until < rw.dataDate %}was due to finish{% else %}due to finish{% endif %} {{ w.until | dom }} {{ w.until | monthShort }}{% if w.untilYear %} {{ w.untilYear }}{% endif %}{% endif -%}
        {# A works registered to start and finish on one day reads badly as
           "starts 25 Aug · until 25 Aug". Say it once. #}
        {%- if w.status == "planned" and w.from and w.from == w.until %} · on {{ w.from | dom }} {{ w.from | monthShort }}{% if w.fromYear %} {{ w.fromYear }}{% endif %}
        {%- else -%}
        {%- if w.status == "planned" and w.from %} · {% if w.from < rw.dataDate %}was due to start{% else %}starts{% endif %} {{ w.from | dom }} {{ w.from | monthShort }}{% if w.fromYear %} {{ w.fromYear }}{% endif %}{% endif -%}
        {%- if w.status == "planned" and w.until %} · until {{ w.until | dom }} {{ w.until | monthShort }}{% if w.untilYear %} {{ w.untilYear }}{% endif %}{% endif -%}
        {%- endif -%}
        {# Impact is only worth printing for high, medium and low: where
            the register says "Road Closure" the work type above already
            says it, and the row would be telling you twice. #}
        {%- if w.impact and w.impact != "Road Closure" and w.impact != "None" %} · {{ w.impact | lower }} impact{% endif -%}
        {# For a permit the title is the object — a skip, scaffolding — so the
           traffic arrangement it causes belongs here instead. #}
        {%- if w.arrangement %} · {{ w.arrangement }}{% endif -%}
        {%- if w.lat and w.lng %} · <a class="map-link" href="#works-map" data-work="{{ loop.index0 }}">show on map →</a>{% endif -%}
      </p>
      {% if whatGloss[w.what] %}<p class="work-gloss">{{ whatGloss[w.what] }}</p>{% endif %}
      {# "May affect" is deliberate. The register records that a service
          passes within ten metres of the works, not that anything was ever
          delayed — anything firmer would claim more than the source does. #}
      {% if w.busText %}<p class="work-buses">May affect buses: {{ w.busText }}</p>{% endif %}
    </div>
  </article>
  {% endfor %}

  <p class="note">Source: Scottish Road Works Register open data (OGL v3),
  updated each night. Positions are as registered by the works promoter and
  can be approximate. Full national map:
  <a href="https://www.roadworksscotland.org">Scottish Road Works Online</a>.</p>

  {% else %}
  <p class="note">Road works data hasn't been fetched yet — the register feed
  will appear here after the next build.</p>
  {% endif %}
</section>

{% if rw.ok %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
/* This page is the one place the site runs JavaScript in the browser —
   the homepage stays pure HTML. Works data is baked in at build time. */
(function () {
  "use strict";
  var WORKS = {{ shown | dump | safe }};
  if (!window.L) return; // CDN unreachable: the list above stands alone.

  var map = L.map("works-map", { scrollWheelZoom: false });
  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
  }).addTo(map);

  /* The year is passed in rather than read off the date: the list rows
     only show it when the date falls outside the register's own year, and
     a popup that disagreed with its row would be worse than either. */
  function shortDate(iso, year) {
    var d = new Date(iso + "T12:00:00Z");
    if (isNaN(d)) return "";
    var s = d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
    return year ? s + " " + year : s;
  }

  var bounds = [];
  var markers = {};
  WORKS.forEach(function (w, i) {
    if (w.lat == null || w.lng == null) return;
    var active = w.status === "active";
    var marker = L.circleMarker([w.lat, w.lng], {
      radius: 9,
      color: "#FBF8F1",
      weight: 2,
      fillColor: active ? "#C03B2B" : "#B07A1F",
      fillOpacity: 0.9
    }).addTo(map);
    var lines = ["<strong>" + (w.what || "Road works") + "</strong>"];
    if (w.where) lines.push(w.where);
    if (w.promoter) lines.push(w.promoter);
    if (active) lines.push(w.until ? "Due to finish " + shortDate(w.until, w.untilYear) : "No end date registered");
    else lines.push(w.from ? "Starts " + shortDate(w.from, w.fromYear) : "Start date to be confirmed");
    marker.bindPopup(lines.join("<br>"));
    markers[i] = marker;
    bounds.push([w.lat, w.lng]);
  });

  if (bounds.length) map.fitBounds(bounds, { padding: [28, 28], maxZoom: 16 });
  else map.setView([55.795, -4.868], 14); // Largs, when nothing is mappable

  /* List → map: each row's "show on map" centres its dot and opens its
     popup. The href is a plain anchor, so without JavaScript the link
     still scrolls to the map — this only adds the aim. */
  document.querySelectorAll(".map-link").forEach(function (link) {
    link.addEventListener("click", function () {
      var i = Number(link.dataset.work);
      if (!WORKS[i] || WORKS[i].lat == null || !markers[i]) return;
      map.setView([WORKS[i].lat, WORKS[i].lng], 17);
      markers[i].openPopup();
    });
  });
})();
</script>
{% endif %}
