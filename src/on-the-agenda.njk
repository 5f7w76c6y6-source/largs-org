  {% endfor %}
  </ul>
{% else %}
  <p class="agenda-none">Nothing in the last {{ agenda.recentDays }} days.</p>
{% endif %}
{% if agenda.readNone | length %}
<p class="agenda-note">Read by this site, with no mention of Largs: {% for m in agenda.readNone %}{% if m.url %}<a href="{{ m.url }}">{{ m.committee }}</a>{% else %}{{ m.committee }}{% endif %} ({{ m.display }}){% if not loop.last %}, {% endif %}{% endfor %}.</p>
{% endif %}
{% if agenda.notYetSearched | length %}
<p class="agenda-note">Not listed: {% for m in agenda.notYetSearched %}{% if m.url %}<a href="{{ m.url }}">{{ m.committee }}</a>{% else %}{{ m.committee }}{% endif %} ({{ m.display }}){% if not loop.last %}, {% endif %}{% endfor %}.
Their papers are published, but the council's search has not found Largs in
