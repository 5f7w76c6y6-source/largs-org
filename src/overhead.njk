<script>
(function () {
  "use strict";

  var HOME = [55.795, -4.87];
  var POLL_MS = 5000;

  // Friendly names for the type codes Largs actually sees. Anything not
  // listed shows its raw ICAO code — honest, and the table grows on request.
  var TYPES = {
    A319:"Airbus A319", A320:"Airbus A320", A321:"Airbus A321",
    A19N:"Airbus A319neo", A20N:"Airbus A320neo", A21N:"Airbus A321neo",
    A332:"Airbus A330-200", A333:"Airbus A330-300", A339:"Airbus A330-900neo",
    A343:"Airbus A340-300", A359:"Airbus A350-900", A35K:"Airbus A350-1000",
    A388:"Airbus A380", A400:"Airbus A400M Atlas",
    B737:"Boeing 737-700", B738:"Boeing 737-800", B38M:"Boeing 737 MAX 8",
    B39M:"Boeing 737 MAX 9", B744:"Boeing 747-400", B748:"Boeing 747-8",
    B752:"Boeing 757-200", B763:"Boeing 767-300", B772:"Boeing 777-200",
    B77L:"Boeing 777-200LR", B77W:"Boeing 777-300ER",
    B788:"Boeing 787-8", B789:"Boeing 787-9", B78X:"Boeing 787-10",
    E145:"Embraer 145", E170:"Embraer 170", E75L:"Embraer 175",
    E190:"Embraer 190", E195:"Embraer 195",
    AT46:"ATR 42-600", AT76:"ATR 72-600", DH8D:"Dash 8 Q400",
    JS41:"Jetstream 41", SB20:"Saab 2000",
    C130:"C-130 Hercules", C30J:"C-130J Super Hercules", P8:"P-8 Poseidon",
    EUFI:"Typhoon", F35:"F-35 Lightning", HAWK:"Hawk",
    EC35:"EC135 helicopter", EC45:"EC145 helicopter", EC55:"EC155 helicopter",
    A109:"AW109 helicopter", A139:"AW139 helicopter", A169:"AW169 helicopter",
    A101:"Merlin helicopter", S76:"Sikorsky S-76 helicopter",
    S92:"Sikorsky S-92 helicopter", B06:"Bell 206 helicopter",
    B429:"Bell 429 helicopter", H47:"Chinook", H60:"Black Hawk",
    R44:"Robinson R44 helicopter", R66:"Robinson R66 helicopter",
    C152:"Cessna 152", C172:"Cessna 172", C182:"Cessna 182",
    P28A:"Piper PA-28", PA28:"Piper PA-28", SR22:"Cirrus SR22",
    DA40:"Diamond DA40", DA42:"Diamond DA42",
    BE20:"King Air 200", PC12:"Pilatus PC-12", TBM9:"TBM 900"
  };

  var OPERATORS = {
    BAW:"British Airways", SHT:"British Airways", EZY:"easyJet",
    RYR:"Ryanair", RUK:"Ryanair UK", LOG:"Loganair", EXS:"Jet2",
    TOM:"TUI", VIR:"Virgin Atlantic", EIN:"Aer Lingus", KLM:"KLM",
    AFR:"Air France", DLH:"Lufthansa", SAS:"SAS", ICE:"Icelandair",
    NOS:"Norwegian", AAL:"American Airlines", UAL:"United", DAL:"Delta",
    ACA:"Air Canada", WJA:"WestJet", UPS:"UPS", FDX:"FedEx",
    GTI:"Atlas Air", CLX:"Cargolux", RRR:"Royal Air Force",
    ASY:"Royal Australian Air Force", CFC:"Canadian Forces", CNV:"US Navy",
    RCH:"US Air Force", NPT:"West Atlantic", HLE:"Helimed", CG:"Coastguard"
  };

  // Rotorcraft: ADS-B category A7 is the aircraft declaring itself a
  // rotorcraft; the type set catches transponders that omit category.
  var HELI_TYPES = { EC35:1, EC45:1, EC55:1, EC30:1, A109:1, A119:1,
    A139:1, A149:1, A169:1, A189:1, A101:1, S61:1, S76:1, S92:1,
    R22:1, R44:1, R66:1, B06:1, B212:1, B412:1, B429:1, B505:1,
    AS32:1, AS50:1, AS55:1, AS65:1, H47:1, H60:1, LYNX:1 };

  function isHeli(a) {
    return a.category === "A7" || (a.t && HELI_TYPES[a.t] === 1);
  }

  var COMPASS = ["north","north-north-east","north-east","east-north-east",
    "east","east-south-east","south-east","south-south-east","south",
    "south-south-west","south-west","west-south-west","west",
    "west-north-west","north-west","north-north-west"];

  var listEl = document.getElementById("ac-list");
  var stampEl = document.getElementById("ac-stamp");
  var emptyEl = document.getElementById("ac-empty");
  var downEl = document.getElementById("ac-down");

  var map = L.map("ac-map", { scrollWheelZoom: false }).setView(HOME, 9);
  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 12,
    attribution: "&copy; OpenStreetMap contributors"
  }).addTo(map);
  L.circleMarker(HOME, { radius: 5, color: "#25655C", fillOpacity: 0.9 })
    .addTo(map).bindPopup("Largs");

  var markers = {};    // hex -> Leaflet marker
  var markerKey = {};  // hex -> "kind|colour", so the icon is only rebuilt when it changes
  var trails = {};  // hex -> { line: Leaflet polyline, pts: [[lat,lon], …] }
  // A jet crosses the 30 nm circle in roughly nine minutes, so the trail
  // is sized to hold a full crossing.
  var TRAIL_MAX = 120;

  // Trails are built here, in the browser, from the positions this page
  // has already seen — no stored history, no extra requests, nothing to
  // keep. They start empty when the page opens and grow as you watch.
  function updateTrail(a) {
    var t = trails[a.hex];
    var wanted = glyphColour(a) || DEFAULT_TRAIL;
    if (!t) {
      t = trails[a.hex] = {
        pts: [],
        // Apple system blue by default — deliberately outside the site
        // palette, on the same principle as the roadworks map's red and
        // the council bin colours: a functional overlay on someone
        // else's map, where legibility beats house harmony. A service
        // aircraft draws its track in its own colour instead.
        line: L.polyline([], {
          color: DEFAULT_TRAIL, weight: 3, opacity: 0.9, interactive: false
        }).addTo(map)
      };
    }
    if (t.colour !== wanted) {
      t.colour = wanted;
      t.line.setStyle({ color: wanted });
    }
    var last = t.pts[t.pts.length - 1];
    if (!last || last[0] !== a.lat || last[1] !== a.lon) {
      t.pts.push([a.lat, a.lon]);
      if (t.pts.length > TRAIL_MAX) t.pts.shift();
      t.line.setLatLngs(t.pts);
    }
  }
  function dropTrail(hex) {
    if (!trails[hex]) return;
    map.removeLayer(trails[hex].line);
    delete trails[hex];
  }

  // Shape follows the aircraft's own broadcast emitter category — the
  // same field that already identifies rotorcraft. Wing plan does the
  // work: straight thin wings for propeller aircraft, swept for jets,
  // widest for the heavies. Nothing is inferred; anything that
  // broadcasts no category gets the airliner shape.
  var GLYPH_PATHS = {
    prop:
      "M12 2 12.8 4.5 12.8 9.4 21.8 11 21.8 12.6 12.8 12.6 12.8 18.4 " +
      "16.4 19.2 16.4 20.6 12.6 20.6 12 22 11.4 20.6 7.6 20.6 7.6 19.2 " +
      "11.2 18.4 11.2 12.6 2.2 12.6 2.2 11 11.2 9.4 11.2 4.5Z",
    airliner:
      "M12 1.5 14 9l8 4v2l-8-1.5V19l2.5 2V22.5L12 21l-4.5 1.5V21L10 19v-5.5" +
      "L2 15v-2l8-4z",
    heavy:
      "M12 1.2 14.4 8.6 23 13.4 23 15.4 14.4 13.8 14.4 19.2 17.4 21.4 " +
      "17.4 22.8 12 21.2 6.6 22.8 6.6 21.4 9.6 19.2 9.6 13.8 1 15.4 " +
      "1 13.4 9.6 8.6Z"
  };

  var PROP_TYPES = { C152:1, C172:1, C182:1, C208:1, P28A:1, PA28:1, PA18:1,
    SR22:1, DA40:1, DA42:1, BE20:1, PC12:1, TBM9:1, AT46:1, AT76:1, AT72:1,
    DH8D:1, JS41:1, SB20:1, C130:1, C30J:1, SF34:1, E110:1 };

  function glyphKind(a) {
    if (isHeli(a)) return "heli";
    if (a.t && PROP_TYPES[a.t]) return "prop";
    var cat = a.category;
    if (cat === "A1" || cat === "A2") return "prop";
    if (cat === "A5") return "heavy";
    return "airliner";
  }

  // Service aircraft take their service's own colour — Coastguard red,
  // ambulance green, police blue — on the same principle as the bin
  // swatches: the colour is a label for a real thing, and the card
  // always names the service in words, so colour never carries the
  // meaning by itself.
  var SERVICE_COLOUR = {
    coastguard: "#C03B2B",
    "air ambulance": "#2F7D4F",
    police: "#1D4ED8"
  };
  var DEFAULT_COLOUR = "#17333A";
  var MILITARY_COLOUR = "#B07A1F";
  var DEFAULT_TRAIL = "#007AFF";

  function glyphColour(a) {
    var tag = serviceTag(a);
    if (tag && SERVICE_COLOUR[tag]) return SERVICE_COLOUR[tag];
    if ((a.dbFlags || 0) & 1) return MILITARY_COLOUR;
    return null; // ordinary aircraft
  }

  function acIcon(kind, colour, track) {
    var deg = (typeof track === "number") ? track : 0;
    var fill = colour || DEFAULT_COLOUR;
    var inner;
    if (kind === "heli") {
      inner =
        '<g class="ac-rotor" stroke="' + fill + '" stroke-width="1.5" ' +
        'stroke-linecap="round">' +
        '<line x1="12" y1="3.2" x2="12" y2="16.8"/>' +
        '<line x1="5.2" y1="10" x2="18.8" y2="10"/></g>' +
        '<g fill="' + fill + '"><ellipse cx="12" cy="10" rx="2.2" ry="3.4"/>' +
        '<rect x="11.4" y="13" width="1.2" height="6.8" rx="0.6"/>' +
        '<rect x="9.6" y="18.8" width="4.8" height="1.4" rx="0.7"/></g>';
    } else {
      inner = '<path fill="' + fill + '" d="' + GLYPH_PATHS[kind] + '"/>';
    }
    return L.divIcon({
      className: "ac-plane",
      iconSize: [26, 26],
      iconAnchor: [13, 13],
      html: '<svg class="ac-glyph" viewBox="0 0 24 24" width="26" height="26" ' +
        'style="transform:rotate(' + deg + 'deg)">' + inner + "</svg>"
    });
  }

  // Replacing the icon element restarts the rotor animation, so when only
  // the heading has changed the existing element is rotated in place.
  function rotateInPlace(marker, track) {
    var el = marker._icon && marker._icon.querySelector
      ? marker._icon.querySelector(".ac-glyph")
      : null;
    if (!el) return false;
    el.style.transform = "rotate(" + ((typeof track === "number") ? track : 0) + "deg)";
    return true;
  }

  // An aircraft with no airline callsign broadcasts its registration in
  // the callsign field instead, without the hyphen — "GXSAS" is G-XSAS.
  // Restoring the hyphen is a formatting convention, not a guess, and it
  // gives these aircraft a registration to search, show and match on.
  function regOf(a) {
    var explicit = (a.r || (a.ident || {}).reg || "").trim();
    if (explicit) return explicit;
    var cs = (a.flight || "").trim().toUpperCase();
    if (/^G[A-Z]{4}$/.test(cs)) return "G-" + cs.slice(1);
    return "";
  }

  function operatorFor(callsign) {
    var m = callsign.match(/^[A-Z]{2,3}/);
    return (m && OPERATORS[m[0]]) || null;
  }

  function feet(n) { return n.toLocaleString("en-GB") + " ft"; }
  function compass(deg) {
    return COMPASS[Math.round(((deg % 360) + 360) % 360 / 22.5) % 16];
  }
  function degStr(deg) { return Math.round(((deg % 360) + 360) % 360) + "\u00B0"; }

  // The extra fields the aircraft is already broadcasting, shown only
  // when present. Squawk is reported plainly, as a number: this page
  // records what is transmitted and does not dramatise it.
  function detailRows(a) {
    var rows = [];
    // An aircraft's air-data probes measure the air flowing past them.
    // Parked, there is no flow: the temperature sensor heat-soaks and
    // reports its own housing (50°C on a sunny apron in Glasgow), the
    // vertical rate drifts, and Mach is meaningless. Those readings are
    // withheld on the ground rather than printed as though they meant
    // something.
    var onGround = a.alt_baro === "ground";

    if (typeof a.track === "number") {
      rows.push(["Heading", compass(a.track) + " (" + degStr(a.track) + ")"]);
    }
    if (!onGround && typeof a.baro_rate === "number" && Math.abs(a.baro_rate) >= 100) {
      rows.push(["Vertical rate",
        Math.abs(a.baro_rate).toLocaleString("en-GB") + " ft/min " +
        (a.baro_rate > 0 ? "climb" : "descent")]);
    }
    if (!onGround && typeof a.nav_altitude_mcp === "number") {
      rows.push(["Selected altitude", feet(a.nav_altitude_mcp)]);
    }
    var sp = [];
    if (typeof a.gs === "number") sp.push(mph(a.gs) + " over the ground");
    if (!onGround && typeof a.mach === "number") sp.push("Mach " + a.mach.toFixed(2));
    if (sp.length) rows.push(["Speed", sp.join(" \u00B7 ")]);
    if (!onGround && typeof a.ws === "number" && typeof a.wd === "number") {
      rows.push(["Wind aloft",
        Math.round(a.ws) + " kt from " + compass(a.wd) + " (" + degStr(a.wd) + ")"]);
    }
    if (!onGround && typeof a.oat === "number") {
      rows.push(["Air temperature", Math.round(a.oat) + "\u00B0C"]);
    }
    if (a.squawk) rows.push(["Squawk", String(a.squawk)]);
    var ident = a.ident || {};
    if (ident.owner) rows.push(["Registered owner", ident.owner]);
    if (ident.model && ident.model !== typeOf(a)) rows.push(["Aircraft", ident.model]);
    var reg = regOf(a);
    if (reg) rows.push(["Registration", reg]);
    return rows;
  }
  function mph(kn) { return Math.round(kn * 1.151).toLocaleString("en-GB") + " mph"; }
  function milesOf(nm) { return (nm * 1.1508).toFixed(nm < 4.5 ? 1 : 0); }

  function whoOf(a) {
    var callsign = (a.flight || "").trim();
    var ident = a.ident || {};
    var who = regOf(a) || callsign || a.hex.toUpperCase();
    // the callsign prefix names the airline; failing that the registered
    // owner names whoever it actually belongs to — which for police, air
    // ambulance, Coastguard and private aircraft is the better answer
    // a documented public service outranks the register's contractor
    var svc = serviceOf(a);
    var op = (svc && svc.name) ||
             (callsign ? operatorFor(callsign) : null) ||
             ident.owner || null;
    return op && op !== who ? op + " " + who : who;
  }

  // Some aircraft fly a public service under contract, so the register
  // names the contractor rather than the service: every UK SAR S-92A is
  // registered to Bristow Helicopters while flying HM Coastguard's
  // service. Translating "Bristow" to "Coastguard" would be a guess —
  // Bristow also flies offshore oil and gas. But the REGISTRATION is a
  // fact: the G-MCG block is the UK SAR fleet (G-MCGG and G-MCGL are
  // based at Prestwick, 20 nm from Largs and inside this circle).
  //
  // So identification runs off registration blocks and the operator's
  // own callsign, never off inference. Add an entry here only when the
  // block is documented as belonging to that service; where nothing
  // matches, the registered owner is shown as-is and no tag appears.
  // Blocks and individual airframes documented as belonging to a
  // service. Verified 22 Aug 2026: the G-MCG block is the UK SAR fleet;
  // the Scottish Ambulance Service aircraft are operated on its behalf
  // by Gama Aviation, so the register names the contractor and only the
  // registration identifies the service. Named airframes will go stale
  // as fleets change — check before adding, and remove what retires.
  // G-WSAS added 23 Aug 2026: seen over Bonhill at 1,675 ft with adsbdb
  // returning "type unknown", so the registration was the only route to
  // identifying it. Confirmed an H145 of the Scottish Ambulance Service,
  // serial 21461, photographed at Glasgow International on 21 Aug 2026.
  var SERVICE_BY_REG = [
    { prefix: "G-MCG", name: "HM Coastguard", tag: "coastguard" },
    { regs: ["G-WSAS", "G-XSAS", "G-GSAS", "G-ISAS", "G-SASC"],
      name: "Scottish Ambulance Service", tag: "air ambulance" },
    { regs: ["G-SCAA", "G-PSCA", "G-NSCA"],
      name: "Scotland's Charity Air Ambulance", tag: "air ambulance" },
    // Police Scotland operates one helicopter for the whole country —
    // G-POLS, with G-PSHU as backup during maintenance — supplied under
    // contract by Babcock, who therefore appear as the registered owner.
    // Verified 22 Aug 2026. NOT to be confused with G-SPHU, one letter
    // apart, an air ambulance airframe whose role has moved between
    // operators: it is deliberately absent.
    { regs: ["G-POLS", "G-PSHU"],
      name: "Police Scotland", tag: "police" }
  ];

  function serviceOf(a) {
    var ident = a.ident || {};
    var reg = regOf(a).toUpperCase().replace(/\s/g, "");
    for (var i = 0; i < SERVICE_BY_REG.length; i++) {
      var e = SERVICE_BY_REG[i];
      if (e.prefix && reg && reg.indexOf(e.prefix) === 0) return e;
      if (e.regs && reg && e.regs.indexOf(reg) >= 0) return e;
    }
    var cs = (a.flight || "").trim().toUpperCase();
    if (cs.indexOf("RESCU") === 0 || cs.indexOf("COASTGUARD") === 0) {
      return { name: "HM Coastguard", tag: "coastguard" };
    }
    // HLE is the flight-ID form of "Helimed", the national callsign for
    // air ambulances. Not inference: the CAA's own squawk allocations
    // pair the two — 0014 Kent (HLE21), 0015 Essex (HLE07), 0016 Thames
    // Valley (HLE24), 0017 London (HLE27), 0003 Surrey/Sussex (HLE60).
    // The operator table above already renders HLE as "Helimed"; this
    // connects that to the tag. WHICH service is not knowable from the
    // callsign, so no name is claimed — the tag stands alone.
    if (cs.indexOf("HLE") === 0) return { name: null, tag: "air ambulance" };
    var owner = (ident.owner || "").toLowerCase();
    if (owner.indexOf("coastguard") >= 0) return { name: null, tag: "coastguard" };
    if (owner.indexOf("ambulance") >= 0) return { name: null, tag: "air ambulance" };
    if (owner.indexOf("police") >= 0) return { name: null, tag: "police" };

    // Squawk 0020 is the UK conspicuity code allocated to "Air Ambulance
    // Helicopter Emergency Medivac". Again not inference — it is what the
    // code means, and the crew selects it when they are on a job.
    //
    // Deliberately LAST, because it is the weakest of the three signals.
    // It is transient: the same helicopter transiting home on 7000 will
    // not match, so the tag appears and disappears with the mission. And
    // a marginal decode could throw up four digits by accident, so it is
    // only trusted on something already declaring itself a rotorcraft —
    // one bad decode should not put a blue-light tag on a light aircraft.
    //
    // Worth having despite that: G-WSAS on 23 Aug broadcast its
    // registration as its callsign with no HLE prefix and no adsbdb
    // record, so neither of the rules above would have caught it. This
    // one would.
    if (String(a.squawk || "").trim() === "0020" && isHeli(a)) {
      return { name: null, tag: "air ambulance" };
    }
    return null;
  }

  // A quiet tag. An air ambulance or Coastguard helicopter overhead
  // usually means someone is having a bad day; the page reports it
  // plainly and does not dramatise it.
  function serviceTag(a) {
    var svc = serviceOf(a);
    return svc ? svc.tag : null;
  }

  function typeOf(a) {
    if (a.t && TYPES[a.t]) return TYPES[a.t];
    if ((a.ident || {}).model) return a.ident.model;
    return a.t || null;
  }

  function routeParts(a) {
    return (a.route && a.route.from && a.route.to) ? a.route : null;
  }

  // Cards are built once per aircraft and then updated in place. The
  // list is never emptied and rebuilt: rebuilding destroyed any open
  // "More detail" disclosure every five seconds, mid-sentence, and made
  // the whole list flicker. Reordering uses appendChild, which MOVES an
  // existing node rather than copying it, so open state, focus and the
  // :target highlight all survive.
  var cards = {}; // hex -> { li, who, type, tags, where, det, dl }

  function span(cls) {
    var el = document.createElement("span");
    el.className = cls;
    return el;
  }

  function makeCard(a) {
    var li = document.createElement("li");
    li.id = "ac-" + a.hex;
    li.className = "ac-row";

    var c = {
      li: li,
      who: span("ac-who"),
      type: span("ac-type"),
      tags: span("ac-tags"),
      where: span("ac-where"),
      det: document.createElement("details"),
      dl: document.createElement("dl"),
      photo: null
    };
    c.det.className = "ac-more";
    var sum = document.createElement("summary");
    sum.textContent = "More detail";
    c.det.appendChild(sum);
    c.det.appendChild(c.dl);

    // A link, not a copy. Photographs of aircraft belong to the people
    // who took them, so this page shows none — it points at a search
    // instead. An image search rather than one photo site because it
    // gathers every venue at once (Planespotters, JetPhotos and the
    // rest), each result still credited and linked back to its source,
    // and because a single site's consent wall was swallowing the
    // registration on first visit and dumping people on its homepage.
    //
    // The query carries the aircraft type as well as the registration,
    // so an airframe nobody has photographed still returns others of the
    // same type. That is why the link says "search for photos" and not
    // "photos of this aircraft": it promises exactly what it does.
    c.photo = document.createElement("a");
    c.photo.className = "ac-photo";
    c.photo.target = "_blank";
    c.photo.rel = "noopener";
    c.photo.textContent = "Search for photos \u2197";
    c.det.appendChild(c.photo);

    li.appendChild(c.who);
    li.appendChild(c.type);
    li.appendChild(c.tags);
    li.appendChild(c.where);
    li.appendChild(c.det);
    return c;
  }

  function updateCard(c, a) {
    var callsign = (a.flight || "").trim();
    var onGround = a.alt_baro === "ground";
    var military = (a.dbFlags || 0) & 1;

    c.li.className = "ac-row" + ((a.seen_pos || 0) > 30 ? " ac-stale" : "");
    c.who.textContent = whoOf(a);
    var typeName = typeOf(a);
    c.type.className = typeName ? "ac-type" : "ac-type ac-type-unknown";
    c.type.textContent = typeName || "type unknown";

    c.tags.textContent = "";
    if (military) {
      var tag = span("ac-tag");
      tag.textContent = "military";
      c.tags.appendChild(tag);
    }
    var svc = serviceTag(a);
    if (svc) {
      var s2 = span("ac-tag ac-tag-service");
      s2.textContent = svc;
      c.tags.appendChild(s2);
    }
    if (onGround) {
      var g = span("ac-tag ac-tag-ground");
      g.textContent = "on the ground";
      c.tags.appendChild(g);
    }

    // one line carries the story: route (when known) · position · height
    // · speed · registration · staleness
    c.where.textContent = "";
    var rp = routeParts(a);
    if (rp) {
      var routeEl = span("ac-route");
      routeEl.textContent = rp.from + " → " + rp.to;
      c.where.appendChild(routeEl);
      c.where.appendChild(document.createTextNode(" · "));
    }

    var dir = COMPASS[Math.round(((a.dir || 0) % 360) / 22.5) % 16];
    var main = onGround
      ? milesOf(a.dst || 0) + " miles " + dir + " of Largs"
      : milesOf(a.dst || 0) + " miles " + dir + " of Largs · " + feet(a.alt_baro) +
        ((a.baro_rate || 0) > 300 ? ", climbing" : (a.baro_rate || 0) < -300 ? ", descending" : "");
    c.where.appendChild(document.createTextNode(main));

    var bits = [];
    if (typeof a.gs === "number" && !onGround) bits.push(mph(a.gs));
    if (a.r && callsign) bits.push(a.r);
    if ((a.seen_pos || 0) > 30) bits.push("position " + Math.round(a.seen_pos) + "s old");
    if (bits.length) {
      var meta = span("ac-meta");
      meta.textContent = " · " + bits.join(" · ");
      c.where.appendChild(meta);
    }

    var reg0 = regOf(a);
    if (reg0) {
      var q = reg0 + " " + (typeOf(a) || "aircraft");
      c.photo.href = "https://www.google.com/search?tbm=isch&q=" +
        encodeURIComponent(q);
      c.photo.hidden = false;
    } else {
      c.photo.removeAttribute("href");
      c.photo.hidden = true;
    }

    // the <details> element itself is never replaced, so `open` persists
    var rows = detailRows(a);
    c.det.hidden = rows.length === 0;
    c.dl.textContent = "";
    rows.forEach(function (r) {
      var dt = document.createElement("dt");
      dt.textContent = r[0];
      var dd = document.createElement("dd");
      dd.textContent = r[1];
      c.dl.appendChild(dt);
      c.dl.appendChild(dd);
    });
  }

  function popupFor(a) {
    var onGround = a.alt_baro === "ground";
    var div = document.createElement("div");
    div.className = "ac-pop";
    var s = document.createElement("strong");
    s.textContent = whoOf(a);
    div.appendChild(s);
    var lines = [];
    lines.push(typeOf(a) || "type unknown");
    // The card shows this as a tag and the glyph carries it as colour, but
    // the popup is the first thing a reader sees on tapping a pin and was
    // the one place that did not say. Named service where the registration
    // identifies one, the bare tag where only the callsign or squawk does.
    // Plain sentence case, no badge: an air ambulance overhead usually
    // means someone is having a bad day, and the page reports it rather
    // than dramatising it.
    var svc = serviceOf(a);
    if (svc) {
      lines.push(svc.name
        || svc.tag.charAt(0).toUpperCase() + svc.tag.slice(1));
    }
    var rp = routeParts(a);
    if (rp) lines.push((rp.iata || "").replace("-", " → "));
    if (!onGround) {
      lines.push(feet(a.alt_baro) + (typeof a.gs === "number" ? " · " + mph(a.gs) : ""));
    } else {
      lines.push("on the ground");
    }
    lines.forEach(function (t) {
      div.appendChild(document.createElement("br"));
      div.appendChild(document.createTextNode(t));
    });
    div.appendChild(document.createElement("br"));
    var link = document.createElement("a");
    link.href = "#ac-" + a.hex;
    link.textContent = "full details ↓";
    div.appendChild(link);
    return div;
  }

  function render(data, staleHeader) {
    var ac = (data.ac || []).filter(function (a) {
      return typeof a.lat === "number" && typeof a.lon === "number";
    });
    ac.sort(function (x, y) {
      var gx = x.alt_baro === "ground" ? 1 : 0;
      var gy = y.alt_baro === "ground" ? 1 : 0;
      return gx - gy || (x.dst || 99) - (y.dst || 99);
    });

    var seen = {};
    ac.forEach(function (a) { seen[a.hex] = true; });

    // drop cards for aircraft that have left the circle
    Object.keys(cards).forEach(function (hex) {
      if (!seen[hex]) {
        if (cards[hex].li.parentNode) listEl.removeChild(cards[hex].li);
        delete cards[hex];
      }
    });

    // update, then re-append in sorted order (appendChild moves nodes)
    ac.forEach(function (a) {
      var c = cards[a.hex] || (cards[a.hex] = makeCard(a));
      updateCard(c, a);
      listEl.appendChild(c.li);
    });

    emptyEl.hidden = ac.length !== 0;
    downEl.hidden = true;

    ac.forEach(function (a) {
      var pos = [a.lat, a.lon];
      updateTrail(a);
      var kind = glyphKind(a);
      var colour = glyphColour(a);
      var key = kind + "|" + (colour || "-");
      if (markers[a.hex]) {
        markers[a.hex].setLatLng(pos);
        if (markerKey[a.hex] !== key || !rotateInPlace(markers[a.hex], a.track)) {
          markers[a.hex].setIcon(acIcon(kind, colour, a.track));
          markerKey[a.hex] = key;
        }
      } else {
        markers[a.hex] = L.marker(pos, { icon: acIcon(kind, colour, a.track) }).addTo(map);
        markers[a.hex].bindPopup("");
        markerKey[a.hex] = key;
      }
      markers[a.hex].getPopup().setContent(popupFor(a));
    });
    Object.keys(markers).forEach(function (hex) {
      if (!seen[hex]) {
        map.removeLayer(markers[hex]);
        delete markers[hex];
        delete markerKey[hex];
      }
    });
    Object.keys(trails).forEach(function (hex) {
      if (!seen[hex]) dropTrail(hex);
    });

    var when = data.now ? new Date(data.now) : new Date();
    var hhmmss = when.toLocaleTimeString("en-GB");
    var age = data.now ? Math.round((Date.now() - data.now) / 1000) : 0;
    stampEl.textContent = "Positions as of " + hhmmss +
      (staleHeader || age > 30 ? " — feed interrupted, showing last received" : "") +
      " · updates every 5 seconds while this page is open";
  }

  function showDown() {
    listEl.textContent = "";
    cards = {};
    Object.keys(markers).forEach(function (hex) {
      map.removeLayer(markers[hex]); delete markers[hex]; delete markerKey[hex];
    });
    Object.keys(trails).forEach(dropTrail);
    emptyEl.hidden = true;
    downEl.hidden = false;
    stampEl.textContent = "Live positions unavailable";
  }

  var failures = 0;
  function poll() {
    fetch("/api/overhead")
      .then(function (r) {
        if (r.status === 503) throw new Error("unavailable");
        var stale = r.headers.get("x-overhead-stale") === "1";
        return r.json().then(function (d) {
          if (d.unavailable) throw new Error("unavailable");
          failures = 0;
          render(d, stale);
        });
      })
      .catch(function () {
        failures += 1;
        if (failures >= 3) showDown();
      });
  }

  var timer = null;
  function start() { if (!timer) { poll(); timer = setInterval(poll, POLL_MS); } }
  function stop() { if (timer) { clearInterval(timer); timer = null; } }

  document.addEventListener("visibilitychange", function () {
    if (document.hidden) { stop(); } else { start(); }
  });
  start();
})();
</script>
