{# Tile icons for the Today board — flat single-colour silhouettes in the
   horizon strip's language (the ferry IS the horizon ferry, miniaturised).
   They inherit the label's colour via currentColor and are decorative:
   aria-hidden, because the label text already names each tile. Identity
   only, never status — the dot keeps that job.

   ONE EXCEPTION: weatherGlyph(), at the foot of this file. What it
   depicts has its own colours rather than currentColor, because the
   sky's appearance IS the information. Its own comment sets out the
   rules that go with that licence.

   The bin used to be the other exception. It is now an illustration
   rather than a glyph — see bin-<colour>.png and the Today board's
   pair hero — so it has left this file entirely. #}
{# weather() is no longer used on the Today board: the tile now carries
   a live condition glyph, and a fixed grey cloud in the label row would
   be FALSE on a sunny day — the only label icon whose subject changes
   state. The word "Weather" is nameplate enough. Kept for any other
   surface that wants a generic weather mark. #}
{% macro weather() %}<svg class="tile-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6.3 14.5h8a3 3 0 0 0 .5-5.96A4.5 4.5 0 0 0 6.1 7.1a3.75 3.75 0 0 0 .2 7.4Z"/></svg>{% endmacro %}
{# tides() is no longer used on the Today board: the tile body draws
   the water itself — the blue-filled curve — so a small wave in the
   label row said the same thing twice. Kept for other surfaces. #}
{% macro tides() %}<svg class="tile-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 12.4C3.8 9 5.7 9 7.4 11.1c1.8 2.1 3.4 2.1 5.2 0C14.4 9 16.2 9 18 11.7v3.8H2Z"/></svg>{% endmacro %}
{% macro seatemp() %}<svg class="tile-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><rect x="8.6" y="2.8" width="2.8" height="9.6" rx="1.4"/><circle cx="10" cy="14.4" r="2.9"/></svg>{% endmacro %}
{% macro daylight() %}<svg class="tile-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><rect x="9.2" y="3.4" width="1.6" height="2.6" rx="0.8"/><rect x="9.2" y="3.4" width="1.6" height="2.6" rx="0.8" transform="rotate(45 10 12)"/><rect x="9.2" y="3.4" width="1.6" height="2.6" rx="0.8" transform="rotate(-45 10 12)"/><path d="M5.2 12a4.8 4.8 0 0 1 9.6 0Z"/><rect x="3" y="13" width="14" height="1.7" rx="0.85"/></svg>{% endmacro %}
{% macro ferry() %}<svg class="tile-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><rect x="3" y="11.8" width="14" height="3.6" rx="1"/><rect x="6" y="8.6" width="7.4" height="2.6" rx="0.8"/><rect x="8.8" y="5.8" width="1.9" height="2.3" rx="0.5"/></svg>{% endmacro %}
{% macro trains() %}<svg class="tile-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.8 4.5h10.4a1.8 1.8 0 0 1 1.8 1.8v6.2a1.8 1.8 0 0 1-1.8 1.8H4.8A1.8 1.8 0 0 1 3 12.5V6.3a1.8 1.8 0 0 1 1.8-1.8Zm.9 2h8.6v3.4H5.7Z"/><circle cx="6.8" cy="16.3" r="1.3"/><circle cx="13.2" cy="16.3" r="1.3"/></svg>{% endmacro %}
{% macro roadworks() %}<svg class="tile-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 3.6 12.03 9H7.97Z"/><path d="M7.34 10.7h5.32l.94 2.5H6.4Z"/><rect x="4.4" y="13.6" width="11.2" height="2" rx="1"/></svg>{% endmacro %}
{# A forecourt pump: body with the price display knocked out, plinth,
   and the hose arm. Three shapes, same weight as ferry() and trains() --
   at 20px anything more becomes mud. Identity only, never status: the
   dot keeps that job, and this pump is the same on a cheap day and a
   dear one. #}
{% macro fuel() %}<svg class="tile-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.2 4.3a1.6 1.6 0 0 1 1.6-1.6h3.8a1.6 1.6 0 0 1 1.6 1.6v11.9H5.2Zm1.7 1.3h3.6v2.9H6.9Z"/><rect x="3.7" y="16.4" width="10.1" height="1.8" rx="0.75"/><path d="M12.6 7.3h1.7a1.5 1.5 0 0 1 1.5 1.5v4.9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>{% endmacro %}
{# bins() is no longer used on the Today board. Same rule as weather(),
   tides() and daylight() — the tile body draws the subject — but this is
   the strongest case of the four: the body's bin carries the week's
   COLLECTION COLOUR, so a fixed grey bin in the label row would show the
   wrong bin two weeks in three. Kept for other surfaces. #}
{% macro bins() %}<svg class="tile-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><rect x="8.3" y="2.6" width="3.4" height="1.6" rx="0.8"/><rect x="5" y="4.6" width="10" height="1.9" rx="0.95"/><path d="M6 7.5h8l-.9 8a1.3 1.3 0 0 1-1.3 1.1H8.2A1.3 1.3 0 0 1 6.9 15.5Z"/></svg>{% endmacro %}
{# The sky, as a picture. THE EXCEPTION to identity-only in this file:
   the sky's appearance IS the information, so the glyph is coloured
   by what it depicts — sun in the board's yellow,
   rain in its blue, cloud in its own grey. The condition is always
   printed beside it, so nothing is lost in greyscale or to anyone who
   cannot tell the shapes apart.

   Fog and snow carry NO opacity: both were --slate softened to .65 and
   .8, which worked only because slate had contrast to spare. The same
   fade on --cloud lands near 2:1 and fails. Full strength or nothing.

   The glyph shows the CURRENT sky (weather_code + is_day). The word
   next to it may add a forecast clause ("Sunny, shower later") — that
   is intentional, not a disagreement: words forecast, pictures depict.
   Unknown codes fall back to the plain cloud. #}
{% macro weatherGlyph(code, isDay=true, cls="weather-glyph") %}<svg class="{{ cls }}" viewBox="0 0 48 48" fill="none" aria-hidden="true">
{%- if code <= 1 and isDay -%}
  {# sun #}
  <circle cx="24" cy="24" r="10" fill="var(--sun)"/>
  <g stroke="var(--sun)" stroke-width="3" stroke-linecap="round">
    <path d="M24 4v6M24 38v6M4 24h6M38 24h6M9.9 9.9l4.2 4.2M33.9 33.9l4.2 4.2M38.1 9.9l-4.2 4.2M14.1 33.9l-4.2 4.2"/>
  </g>
{%- elif code <= 1 -%}
  {# moon. --cloud, not --slate: slate is the masthead and the horizon,
     the site's structural ink. Everything the board DEPICTS has its own
     colour — sun in --sun, rain in --rain, cloud and moon in --cloud —
     and a dark moon beside the pale one in moon-behind-cloud read as two
     different objects rather than one at two sizes. #}
  <path d="M31 6a17 17 0 1 0 11 30A19 19 0 0 1 31 6Z" fill="var(--cloud)"/>
{%- elif code == 2 and isDay -%}
  {# sun behind cloud #}
  <circle cx="18" cy="17" r="8" fill="var(--sun)"/>
  <g stroke="var(--sun)" stroke-width="2.6" stroke-linecap="round">
    <path d="M18 3v4M4 17h4M8.1 7.1l2.8 2.8M27.9 7.1l-2.8 2.8"/>
  </g>
  <path d="M14 40h20a7 7 0 0 0 1.2-13.9A10.5 10.5 0 0 0 14.9 23a8.75 8.75 0 0 0-.9 17Z" fill="var(--cloud)"/>
{%- elif code == 2 -%}
  {# moon behind cloud. The crescent sits CLEAR of the cloud at top right,
     not tucked inside it: overlapped, the two shapes merged into one lump
     at 26px and read as neither. It is the clear-night moon's own path,
     scaled to about half and moved, so the vocabulary stays consistent.
     Both shapes take --cloud at full strength — the moon was --slate at
     .55, which made the thing BEHIND darker than the thing in front. #}
  <path d="M33.9 0.9a8.2 8.2 0 1 0 5.3 14.4A9.1 9.1 0 0 1 33.9 0.9Z" fill="var(--cloud)"/>
  <path d="M14 42h20a7 7 0 0 0 1.2-13.9A10.5 10.5 0 0 0 14.9 25a8.75 8.75 0 0 0-.9 17Z" fill="var(--cloud)"/>
{%- elif code == 45 or code == 48 -%}
  {# fog: the ONE hollow glyph in the set, and deliberately so. Fog is
     the only condition you can see through, so an outlined cloud
     depicts transparency where every other glyph depicts something
     opaque. Three lobes rather than the generic two-bump body, and
     mist as broken segments rather than ruled lines — staggered so no
     two align, which is what reads as drift. Two segments cross the
     cloud's lower third only: higher would cut the silhouette in half
     and it would stop being a cloud. #}
  <path d="M10 32a5.5 5.5 0 0 1 4.6-9.6a10.5 10.5 0 0 1 18.8-3.2a7.5 7.5 0 0 1 6.6 12.8Z" fill="none" stroke="var(--cloud)" stroke-width="3.4" stroke-linejoin="round"/>
  <g stroke="var(--cloud)" stroke-width="3.4" stroke-linecap="round">
    <path d="M24 26h12M5 29.5h12M41 29.5h4M6 38h12M23 38h15M20 43.5h20"/>
  </g>
{%- elif code >= 95 -%}
  {# thunder #}
  <path d="M12 32h24a7 7 0 0 0 1.2-13.9A10.5 10.5 0 0 0 12.9 15a8.75 8.75 0 0 0-.9 17Z" fill="var(--cloud)"/>
  <path d="M26 30l-7 10h5l-3 8 9-11h-5l3-7Z" fill="var(--sun)"/>
{%- elif code >= 71 and code <= 86 and code != 80 and code != 81 and code != 82 -%}
  {# snow #}
  <path d="M12 30h24a7 7 0 0 0 1.2-13.9A10.5 10.5 0 0 0 12.9 13a8.75 8.75 0 0 0-.9 17Z" fill="var(--cloud)"/>
  <g fill="var(--cloud)">
    <circle cx="16" cy="38" r="2.1"/><circle cx="24" cy="42" r="2.1"/><circle cx="32" cy="38" r="2.1"/>
  </g>
{%- elif code >= 80 and isDay -%}
  {# showers: sun behind cloud, drops #}
  <circle cx="17" cy="15" r="7" fill="var(--sun)"/>
  <path d="M13 36h22a7 7 0 0 0 1.2-13.9A10.5 10.5 0 0 0 13.9 19a8.75 8.75 0 0 0-.9 17Z" fill="var(--cloud)"/>
  <g stroke="var(--rain)" stroke-width="3" stroke-linecap="round">
    <path d="M17 40l-2 5M25 40l-2 5M33 40l-2 5"/>
  </g>
{%- elif code >= 61 or code >= 80 -%}
  {# rain #}
  <path d="M12 32h24a7 7 0 0 0 1.2-13.9A10.5 10.5 0 0 0 12.9 15a8.75 8.75 0 0 0-.9 17Z" fill="var(--cloud)"/>
  <g stroke="var(--rain)" stroke-width="3" stroke-linecap="round">
    <path d="M16 36l-2 6M24 36l-2 6M32 36l-2 6"/>
  </g>
{%- elif code >= 51 -%}
  {# drizzle: two lighter drops #}
  <path d="M12 32h24a7 7 0 0 0 1.2-13.9A10.5 10.5 0 0 0 12.9 15a8.75 8.75 0 0 0-.9 17Z" fill="var(--cloud)"/>
  <g stroke="var(--rain)" stroke-width="2.4" stroke-linecap="round" opacity=".8">
    <path d="M19 36l-1.5 5M29 36l-1.5 5"/>
  </g>
{%- else -%}
  {# overcast, and the fallback for anything unrecognised #}
  <path d="M12 34h24a7.5 7.5 0 0 0 1.3-14.9A11 11 0 0 0 13 16a9.4 9.4 0 0 0-1 18Z" fill="var(--cloud)"/>
{%- endif -%}
</svg>{% endmacro %}


