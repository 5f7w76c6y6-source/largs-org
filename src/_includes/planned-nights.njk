{# Planned OVERNIGHT closure on named nights (27 Nov 2026, Ian: "people are
   interested in more than just now"). Included by planned-notice.njk for a
   planned.json closure that carries `nights`: the dates (Largs calendar)
   on whose evening the road closes at `closeFrom`, reopening at `closeTo`
   the next morning. Unlike the daily closure it is shown AHEAD of the
   first night, from `starts`, so a reader can plan round it.

   `text` (Roadworks) and `textShort` (Today board) are whole sentences,
   true at any hour as written, so the notice stands with JavaScript off.
   The script changes only the badge, by the Largs clock: "Closes 20:00
   Sunday" / "tomorrow" / "tonight" before, "Closed until 06:00" (and red)
   inside the hours, and hides the notice once the last night has ended.
   These are the operator's published hours, not a reading of the road.
   Traffic Scotland's own closure reports are left in their own box. #}
<div class="wrap">
  <div class="power-notice planned-notice" role="status" id="planned-{{ c.id }}"
       data-from="{{ c.closeFrom }}" data-to="{{ c.closeTo }}" data-nights="{{ c.nights | join(",") }}">
    <span class="power-notice-badge">Overnight closure</span>
    <span class="power-notice-text">
      {% if trunkAll %}<strong>{{ c.road }}</strong> — {{ c.text }} · <a href="/buses/">Buses →</a>
      {% else %}<strong>{{ c.road }}</strong> — {{ c.textShort }} · <a href="/roadworks/">Roadworks →</a> · <a href="/buses/">Buses →</a>{% endif %}
    </span>
    <span class="power-notice-src">{{ c.source }}</span>
  </div>
</div>
<script>
(function () {
  var el = document.getElementById("planned-{{ c.id }}");
  if (!el) return;
  var badge = el.querySelector(".power-notice-badge");
  var from = el.getAttribute("data-from"), to = el.getAttribute("data-to");
  var nights = el.getAttribute("data-nights").split(",");
  var DAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
  function shift(iso, n) {
    var d = new Date(iso + "T12:00:00Z");
    d.setUTCDate(d.getUTCDate() + n);
    return d.toISOString().slice(0, 10);
  }
  function largs() {
    try {
      var d = new Date();
      return {
        time: new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/London", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(d),
        day: new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/London", year: "numeric", month: "2-digit", day: "2-digit" }).format(d)
      };
    } catch (e) { return null; }
  }
  function tick() {
    var n = largs();
    if (!n || !/^\d\d:\d\d$/.test(n.time) || !/^\d{4}-\d\d-\d\d$/.test(n.day)) return;
    // Closed: this evening is one of the nights and it has begun, or last
    // evening was one and its morning has not yet come.
    var closed = (nights.indexOf(n.day) !== -1 && n.time >= from)
      || (nights.indexOf(shift(n.day, -1)) !== -1 && n.time < to);
    var next = null;
    for (var i = 0; i < nights.length; i++) {
      if (nights[i] > n.day || (nights[i] === n.day && n.time < from)) { next = nights[i]; break; }
    }
    if (!closed && !next) { el.hidden = true; return; }
    el.classList.toggle("is-closed", closed);
    badge.textContent = closed ? "Closed until " + to
      : next === n.day ? "Closes " + from + " tonight"
      : next === shift(n.day, 1) ? "Closes " + from + " tomorrow"
      : "Closes " + from + " " + DAYS[new Date(next + "T12:00:00Z").getUTCDay()];
  }
  tick();
  setInterval(tick, 30000);
})();
</script>
