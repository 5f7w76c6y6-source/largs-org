<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;1,400&family=Spline+Sans+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>

<header class="masthead">
  <div class="wrap">
    <div class="masthead-inner">
      <div>
        <a class="wordmark" href="/">largs<span>.org</span></a>
        <div class="tagline">Largs for You</div>
      </div>
      <div class="dateline">{{ buildTime | dateLong }} · Firth of Clyde</div>
    </div>
    <nav class="mainnav" aria-label="Main">
      <ul>
        <li><a href="/" aria-current="page">Today</a></li>
        <li><a href="#">What's on</a></li>
        <li><a href="#">Council corner</a></li>
        <li><a href="#">Directory</a></li>
        <li><a href="#">Getting about</a></li>
        <li><a href="#">Archive</a></li>
        <li><a href="#">About</a></li>
      </ul>
    </nav>
  </div>
</header>

{# Signature: the Largs horizon — Cumbrae, a CalMac ferry mid-crossing, and the Pencil #}
<div class="horizon" role="img" aria-label="Silhouette of the Largs horizon: Great Cumbrae across the water, the ferry mid-crossing, and the Pencil monument on the shore">
  <svg viewBox="0 0 1200 64" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <rect width="1200" height="64" fill="#BFDED2"/>
    <rect y="46" width="1200" height="18" fill="#17333A"/>
    <path d="M0 46 L120 46 Q210 18 320 34 Q420 46 520 46 Z" fill="#17333A"/>
    <path d="M300 46 Q400 26 500 40 Q560 46 620 46 Z" fill="#17333A" opacity="0.55"/>
    <g fill="#17333A">
      <rect x="700" y="38" width="58" height="8" rx="2"/>
      <rect x="712" y="31" width="30" height="7" rx="1.5"/>
      <rect x="723" y="24" width="7" height="7" rx="1"/>
    </g>
    <g fill="#17333A">
      <rect x="1074" y="14" width="10" height="32"/>
      <path d="M1072 14 L1079 2 L1086 14 Z"/>
      <rect x="1066" y="42" width="26" height="4"/>
    </g>
  </svg>
</div>

<main>
{{ content | safe }}
</main>

<footer>
  <div class="wrap">
    <div class="foot">
      <div class="founder">
        <h3>A site with a history</h3>
        <p>largs.org was founded by [founder name] and run by [him/them] for more than two decades — welcoming visitors to the town since before most of Largs had broadband. The original site is preserved, complete and unchanged, in our <a href="#">Archive</a>.</p>
      </div>
      <div class="foot-meta">
        <h4>About this site</h4>
        <p>Community-run, for the town. The domain stays in community hands — that's a promise in writing.<br>
        <a href="#">Contact</a> · <a href="#">Accessibility</a> · <a href="#">Local sponsors</a></p>
      </div>
    </div>
    <div class="colophon">
      <span>largs.org · Largs for You</span>
      <span>Weather &amp; tide model data © <a href="https://open-meteo.com">Open-Meteo.com</a> (CC BY 4.0)</span>
    </div>
  </div>
</footer>

</body>
</html>
