{# Register macros, shared by /council/ and the generated filter pages.
   Kept in one file so the issue card can never drift between them: the
   card is the neutrality guarantee — same shape for every item and every
   person — and two copies of it would eventually stop matching.

   Status is never carried by colour alone. Every one renders a glyph and
   a word, and statusKey() spells all four out in the same terms as
   council.json's _comment.

   The label and glyph maps are declared INSIDE each macro rather than
   once at the top of the file. That looks like needless repetition and
   isn't: a macro imported into another template does not reliably carry
   its defining template's top-level {% set %} variables, so a
   module-level map would render empty labels on every page that imports
   from here while working perfectly in the file itself. Scope safety
   beats tidiness — and both maps sit within a screen of each other, so
   drift stays visible. #}

{# One issue. `minutesUrl` is passed rather than read from the global so
   the macro has no hidden dependency on the data cascade. #}
{# `latestMinutes` is passed so the card can say when its own record has
   gone quiet. Optional: called without it, the staleness line simply never
   renders, so nothing breaks if a future template forgets it. #}
{% macro issueCard(item, minutesUrl, latestMinutes) %}
{% set labels = { "raised": "Raised", "progress": "In progress", "completed": "Completed", "no-update": "No recent update" } %}
{% set glyphs = { "raised": "◇", "progress": "◐", "completed": "●", "no-update": "○" } %}
<article class="issue" id="issue-{{ item.id }}">
  <div class="issue-head">
    <h3 class="issue-title">{{ item.title }}</h3>
    <span class="issue-status {{ item.status }}"><span aria-hidden="true">{{ glyphs[item.status] }}</span> {{ labels[item.status] }}</span>
  </div>

  <p class="issue-summary">{{ item.summary }}</p>

  <div class="issue-meta">
    <div><span class="issue-label">Responsible</span> · {{ item.responsible }}</div>
    {% if item.nextStep %}
    <div><span class="issue-label">Next step</span> · {{ item.nextStep }}</div>
    {% endif %}
    <div><span class="issue-label">Last recorded</span> · {{ item.lastRecorded | dateLong }}{% if minutesUrl %} · <a href="{{ minutesUrl }}">minutes</a>{% endif %}</div>
    {% if latestMinutes and (item.lastRecorded | monthsBetween(latestMinutes)) >= 6 %}
    <p class="issue-stale">No later minutes mention this item. That describes the
    written record, not necessarily what has happened since.</p>
    {% endif %}
    {% if item.alsoRecorded and item.alsoRecorded.length %}
    <div class="issue-history">Also recorded {% for d in item.alsoRecorded %}{{ d | dateLong }}{% if not loop.last %}, {% endif %}{% endfor %}</div>
    {% endif %}
  </div>
</article>
{% endmacro %}

{% macro statusKey() %}
<h4 class="status-key-head">What the statuses mean</h4>
<ul class="status-key">
  <li><span class="issue-status raised"><span aria-hidden="true">◇</span> Raised</span>
    Recorded in the minutes, with no action yet assigned or taken.</li>
  <li><span class="issue-status progress"><span aria-hidden="true">◐</span> In progress</span>
    An action is assigned, and the minutes record it moving.</li>
  <li><span class="issue-status completed"><span aria-hidden="true">●</span> Completed</span>
    The minutes record the matter as done. Completed means it was settled,
    not that everyone was content with how.</li>
  <li><span class="issue-status no-update"><span aria-hidden="true">○</span> No recent update</span>
    The item appears in two or more meetings with nothing new recorded.</li>
</ul>
{% endmacro %}

{# The counts strip. This is load-bearing for neutrality, not decoration:
   it is what stops a filtered view reading as a highlight reel. Every
   filter page and the hub carry it, so any single slice is visibly one
   part of a whole record and the rest is one click away.
   `current` is the slug of the page being rendered, or "" on the hub. #}
{% macro registerNav(council, current) %}
{% set glyphs = { "raised": "◇", "progress": "◐", "completed": "●", "no-update": "○" } %}
<nav class="register-nav" aria-label="The issue register">
  <ul>
    {% for s in council.statuses %}
    <li>
      <a href="/council/{{ s.slug }}/"
         class="register-tab{% if s.key %} {{ s.key }}{% endif %}"
         {% if current == s.slug %}aria-current="page"{% endif %}>
        {% if s.key %}<span aria-hidden="true">{{ glyphs[s.key] }}</span> {% endif %}{{ s.label }}
        <span class="register-count">{{ council.digest | byStatus(s.key) | length }}</span>
      </a>
    </li>
    {% endfor %}
  </ul>
</nav>
{% endmacro %}

{# Coverage disclosure. Rendered on every register page, because a reader
   who lands on a filter page from a search result never sees the hub. #}
{% macro coverageNote(council) %}
<p class="freshness">Latest published Community Council minutes:
<strong>{{ council.latestMinutes | monthYear }}</strong>.
{{ council.coverage.note }}{% if council.minutesUrl %}
<a href="{{ council.minutesUrl }}">Minutes archive →</a>{% endif %}</p>
{% endmacro %}
