{# Journey times now (19 Nov 2026). Rendered only when THIS build read
   Traffic Scotland's Travel Time Data and at least one journey has a
   fresh reading for every stretch -- see loadJourneys in
   scripts/fetch-data.mjs. A journey with a silent stretch is left out and
   named in the line underneath, never estimated.

   The figure is the time now; the line under it compares it with the time
   Traffic Scotland expects at this hour. The amber dot marks "slower" and
   the words say by how much, so the colour is never the only signal.
   "Roadhead" is the A760 / A737 junction, the name the Haylie Brae road
   view already uses; the line underneath explains it. #}
{% set jt = today.journeys %}
{% if jt and jt.ok and jt.items | length %}
<div class="jt" role="region" aria-labelledby="jt-h" data-measured="{{ jt.measuredAt }}">
  <div class="jt-head">
    <h2 id="jt-h">Journey times now</h2>
    <span class="jt-stamp">Traffic Scotland · measured {{ jt.measuredAt | hhmm }}<span class="jt-age" hidden></span></span>
  </div>
  <div class="jt-grid jt-n{{ jt.items | length }}">
    {% for j in jt.items %}
    <div class="jt-row">
      <div class="jt-name">{{ j.from }} <span>to</span> {{ j.to }}</div>
      {# A closure in the incident feed on this route: no figure. The
         travel-time feed does not know the road is shut (see tsMarkClosed). #}
      {% if j.state == 'closed' %}
      <div class="jt-time jt-shut">Closed</div>
      <div class="jt-note shut">{{ j.note }}{% if today.trunk and today.trunk.ok %} · see the notice above{% endif %}</div>
      {% else %}
      <div class="jt-time">{{ j.minutes }}<small>min</small></div>
      <div class="jt-note{% if j.state == 'slow' %} slow{% endif %}">{{ j.note }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {# Shown by the script below in place of the cards once the figures are
     too old to be called "now". #}
  <p class="jt-stale" hidden>No current journey times. The last figures were
  measured at {{ jt.measuredAt | hhmm }} and are too old to rely on; the page
  is rebuilt every 15 minutes.</p>
  <p class="jt-foot">By car on the A78 and A737, measured by Traffic Scotland
  every five minutes. Haylie Brae to the town centre is the A78 from the foot of
  the brae to Main Street. Roadhead Roundabout is where the Haylie Brae road
  meets the A737.{% if jt.missing | length %} Not shown: {{ jt.missing | join(" and ") }}
  — part of that road is not reporting.{% endif %}</p>
</div>
{# HOW OLD (19 Nov 2026). This page is built, then read some time later --
   minutes usually, hours if the build ever stops. Only the reader's
   browser knows how long ago "measured 20:45" was, so it says so, and
   past JT_STALE_MIN it swaps the cards for the plain line above. The
   limit allows for a quarter-hourly rebuild plus the time Traffic
   Scotland's readings are already behind when we fetch them (19 minutes
   on the first evening). #}
<script>
(function () {
  var JT_STALE_MIN = 40;
  var el = document.querySelector(".jt[data-measured]");
  if (!el) return;
  var at = Date.parse(el.getAttribute("data-measured"));
  if (!at) return;
  var age = el.querySelector(".jt-age"), stale = el.querySelector(".jt-stale");
  function tick() {
    var min = Math.round((Date.now() - at) / 60000);
    if (min < 0) return; // a clock that is wrong says nothing
    age.textContent = " \u00b7 " + (min < 1 ? "just now" : min < 100 ? min + " min ago" : "over " + Math.floor(min / 60) + " hours ago");
    age.hidden = false;
    var old = min > JT_STALE_MIN;
    el.classList.toggle("jt-is-stale", old);
    stale.hidden = !old;
  }
  tick();
  setInterval(tick, 60000);
})();
</script>
{% endif %}
